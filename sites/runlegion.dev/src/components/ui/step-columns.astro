---
import type { HTMLAttributes } from 'astro/types';
import classy from '@/lib/primitives/classy';
import Container from '@/components/ui/container.astro';
import Grid from '@/components/ui/grid.astro';
import Typography from '@/components/ui/typography.astro';

interface Props extends HTMLAttributes<'div'> {
  leftLabel: string;
  rightLabel: string;
  leftColor?: string;
  leftItems: string[];
  rightItems: string[];
}

const { leftLabel, rightLabel, leftColor = 'primary', leftItems, rightItems, class: className, ...attrs } = Astro.props;
const gridId = `step-columns-${leftLabel.toLowerCase().replace(/\W+/g, '-')}`;
---

<div class={classy('border-t border-border', className)} {...attrs}>
  <Grid id={gridId}preset="linear" columns={2} gap="6" padding="4">
    <Container gap="2">
      <Typography as="span" variant="muted" family="mono" transform="uppercase" tracking="widest" weight="semibold" color={leftColor}>{leftLabel}</Typography>
      {leftItems.map((item) => (
        <Typography as="p" variant="muted">{item}</Typography>
      ))}
    </Container>
    <Container gap="2">
      <Typography as="span" variant="muted" family="mono" transform="uppercase" tracking="widest" weight="semibold">{rightLabel}</Typography>
      {rightItems.map((item) => (
        <Typography as="p" variant="muted">{item}</Typography>
      ))}
    </Container>
  </Grid>
</div>
