---
// Network topology diagram showing legion deployed across a LAN with a WAN tunnel.
// Static layout with subtle ambient animation. Same visual language as hero.
---

<div class="arch-wrap">
  <canvas id="arch-canvas" width="860" height="500"></canvas>
</div>

<style>
  .arch-wrap { width: 100%; margin-bottom: 24px; }
  #arch-canvas {
    width: 100%; height: auto; display: block;
    border: 1px solid #005f6b; border-radius: 4px;
    box-shadow: 0 0 40px #00e5ff18, inset 0 0 60px #00102040;
    background: #020810;
  }
</style>

<script>
  function initArchCanvas() {
    const canvas = document.getElementById("arch-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext("2d")!;
    const W = 860, H = 460;
    canvas.width = W; canvas.height = H;

    const CYAN = "#00e5ff", CYAN_DIM = "#005f6b";
    const GREEN = "#00ff9d";
    const AMBER = "#ffb300";
    const BG = "#020810";
    const MUTED = "#8ab4c8";

    let t = 0;
    let tunnelParticles: any[] = [];
    let lanParticles: any[] = [];

    // LAN boundary
    const lanX = 30, lanY = 30, lanW = 540, lanH = 400;

    // LAN machines -- bigger hexes to contain agents
    const lanNodes = [
      { x: 160, y: 170, label: "workstation", agents: ["frontend", "backend", "testing"], r: 70 },
      { x: 410, y: 170, label: "lab", agents: ["data", "docs"], r: 60 },
      { x: 280, y: 340, label: "nas", agents: ["backup"], r: 50 },
    ];

    // Remote machine (through tunnel)
    const remoteX = 720, remoteY = 230;
    const remoteNode = { x: remoteX, y: remoteY, label: "build-server", agents: ["ci", "deploy"], r: 60 };

    // Tunnel endpoints
    const tunnelLanX = lanX + lanW;
    const tunnelLanY = 230;
    const tunnelRemoteX = remoteX - 70;
    const tunnelRemoteY = remoteY;

    function drawHex(x: number, y: number, r: number, color: string, pulse: boolean) {
      const pr = r + (pulse ? Math.sin(t * 0.03) * 1.5 : 0);
      ctx.beginPath();
      for (let i = 0; i < 6; i++) {
        const angle = (Math.PI / 180) * (60 * i - 30);
        const px = x + pr * Math.cos(angle), py = y + pr * Math.sin(angle);
        if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      const grad = ctx.createRadialGradient(x, y, 0, x, y, pr);
      grad.addColorStop(0, color + "15"); grad.addColorStop(1, color + "03");
      ctx.fillStyle = grad; ctx.fill();
      ctx.strokeStyle = color; ctx.lineWidth = 1.2;
      ctx.shadowColor = color; ctx.shadowBlur = 10;
      ctx.stroke(); ctx.shadowBlur = 0;
    }

    function drawAgent(x: number, y: number, label: string, color: string) {
      const pulse = 3 + Math.sin(t * 0.04 + x * 0.01) * 0.8;
      ctx.beginPath(); ctx.arc(x, y, pulse, 0, Math.PI * 2);
      ctx.fillStyle = color; ctx.globalAlpha = 0.8;
      ctx.shadowColor = color; ctx.shadowBlur = 6;
      ctx.fill(); ctx.shadowBlur = 0; ctx.globalAlpha = 1;

      ctx.font = "14px 'Share Tech Mono', monospace";
      ctx.fillStyle = color + "99"; ctx.textAlign = "center";
      ctx.fillText(label, x, y + 12);
    }

    function drawLanBoundary() {
      // Rounded rect with subtle glow
      const r = 12;
      ctx.beginPath();
      ctx.moveTo(lanX + r, lanY);
      ctx.lineTo(lanX + lanW - r, lanY);
      ctx.arcTo(lanX + lanW, lanY, lanX + lanW, lanY + r, r);
      ctx.lineTo(lanX + lanW, lanY + lanH - r);
      ctx.arcTo(lanX + lanW, lanY + lanH, lanX + lanW - r, lanY + lanH, r);
      ctx.lineTo(lanX + r, lanY + lanH);
      ctx.arcTo(lanX, lanY + lanH, lanX, lanY + lanH - r, r);
      ctx.lineTo(lanX, lanY + r);
      ctx.arcTo(lanX, lanY, lanX + r, lanY, r);
      ctx.closePath();

      ctx.strokeStyle = CYAN_DIM;
      ctx.lineWidth = 1;
      ctx.globalAlpha = 0.3 + Math.sin(t * 0.02) * 0.05;
      ctx.setLineDash([8, 6]);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      // LAN label
      ctx.font = "14px 'Share Tech Mono', monospace";
      ctx.fillStyle = CYAN + "55"; ctx.textAlign = "left";
      ctx.fillText("192.168.1.0/24", lanX + 12, lanY + 16);

      // Legend
      ctx.fillStyle = CYAN_DIM; ctx.textAlign = "left";
      ctx.fillText("local network", lanX + 12, lanY + lanH - 10);
    }

    function drawTunnel() {
      // WAN tunnel line
      const midX = (tunnelLanX + tunnelRemoteX) / 2;
      const midY = tunnelLanY - 40;

      ctx.beginPath();
      ctx.moveTo(tunnelLanX, tunnelLanY);
      ctx.quadraticCurveTo(midX, midY, tunnelRemoteX, tunnelRemoteY);

      // Double line for tunnel
      ctx.strokeStyle = AMBER;
      ctx.lineWidth = 2;
      ctx.globalAlpha = 0.25 + Math.sin(t * 0.03) * 0.1;
      ctx.setLineDash([4, 8]);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.globalAlpha = 1;

      // Tunnel label
      ctx.font = "14px 'Share Tech Mono', monospace";
      ctx.fillStyle = AMBER + "88"; ctx.textAlign = "center";
      ctx.fillText("WireGuard tunnel", midX, midY - 6);

      // Particles along tunnel
      if (t % 60 === 0) {
        tunnelParticles.push({ progress: 0, speed: 0.008 + Math.random() * 0.005 });
      }
      tunnelParticles = tunnelParticles.filter(p => p.progress < 1);
      for (const p of tunnelParticles) {
        p.progress += p.speed;
        const pt = p.progress;
        const mt = 1 - pt;
        const px = mt * mt * tunnelLanX + 2 * mt * pt * midX + pt * pt * tunnelRemoteX;
        const py = mt * mt * tunnelLanY + 2 * mt * pt * midY + pt * pt * tunnelRemoteY;
        const alpha = Math.sin(pt * Math.PI);

        ctx.beginPath(); ctx.arc(px, py, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = AMBER; ctx.globalAlpha = alpha * 0.8;
        ctx.shadowColor = AMBER; ctx.shadowBlur = 6;
        ctx.fill(); ctx.shadowBlur = 0; ctx.globalAlpha = 1;
      }
    }

    function drawLanConnections() {
      // Lines between LAN nodes (mesh)
      for (let i = 0; i < lanNodes.length; i++) {
        for (let j = i + 1; j < lanNodes.length; j++) {
          const a = lanNodes[i], b = lanNodes[j];
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = CYAN_DIM;
          ctx.globalAlpha = 0.15;
          ctx.lineWidth = 0.8;
          ctx.setLineDash([3, 9]);
          ctx.stroke();
          ctx.setLineDash([]);
          ctx.globalAlpha = 1;
        }
      }

      // LAN sync particles
      if (t % 80 === 0 && lanNodes.length >= 2) {
        const si = Math.floor(Math.random() * lanNodes.length);
        let ti = Math.floor(Math.random() * lanNodes.length);
        while (ti === si) ti = Math.floor(Math.random() * lanNodes.length);
        lanParticles.push({
          sx: lanNodes[si].x, sy: lanNodes[si].y,
          tx: lanNodes[ti].x, ty: lanNodes[ti].y,
          progress: 0, speed: 0.015 + Math.random() * 0.01,
        });
      }
      lanParticles = lanParticles.filter(p => p.progress < 1);
      for (const p of lanParticles) {
        p.progress += p.speed;
        const px = p.sx + (p.tx - p.sx) * p.progress;
        const py = p.sy + (p.ty - p.sy) * p.progress;
        const alpha = Math.sin(p.progress * Math.PI);

        ctx.beginPath(); ctx.arc(px, py, 2, 0, Math.PI * 2);
        ctx.fillStyle = GREEN; ctx.globalAlpha = alpha * 0.7;
        ctx.shadowColor = GREEN; ctx.shadowBlur = 5;
        ctx.fill(); ctx.shadowBlur = 0; ctx.globalAlpha = 1;
      }
    }

    function drawNode(node: any, isRemote = false) {
      drawHex(node.x, node.y, node.r, CYAN, true);

      // Machine label at top of hex
      ctx.font = "bold 13px 'Share Tech Mono', monospace";
      ctx.fillStyle = CYAN; ctx.textAlign = "center";
      ctx.fillText(node.label, node.x, node.y - node.r * 0.35);

      // Agent dots + labels arranged inside the hex
      const agentCount = node.agents.length;
      const agentY = node.y + node.r * 0.15;
      const totalWidth = (agentCount - 1) * (node.r * 0.7);
      const startX = node.x - totalWidth / 2;

      for (let i = 0; i < agentCount; i++) {
        const ax = agentCount === 1 ? node.x : startX + i * (node.r * 0.7);
        const ay = agentY;
        const colors = [GREEN, GREEN, AMBER];
        const color = colors[i % colors.length];

        // Agent dot
        const pulse = 4 + Math.sin(t * 0.04 + ax * 0.01) * 1;
        ctx.beginPath(); ctx.arc(ax, ay, pulse, 0, Math.PI * 2);
        ctx.fillStyle = color; ctx.globalAlpha = 0.85;
        ctx.shadowColor = color; ctx.shadowBlur = 8;
        ctx.fill(); ctx.shadowBlur = 0; ctx.globalAlpha = 1;

        // Agent label below dot
        ctx.font = "11px 'Share Tech Mono', monospace";
        ctx.fillStyle = color + "bb"; ctx.textAlign = "center";
        ctx.fillText(node.agents[i], ax, ay + 16);
      }
    }

    function drawRemoteBoundary() {
      const rx = remoteX - 90, ry = remoteY - 90, rw = 180, rh = 180;
      const r = 8;
      ctx.beginPath();
      ctx.moveTo(rx + r, ry);
      ctx.lineTo(rx + rw - r, ry);
      ctx.arcTo(rx + rw, ry, rx + rw, ry + r, r);
      ctx.lineTo(rx + rw, ry + rh - r);
      ctx.arcTo(rx + rw, ry + rh, rx + rw - r, ry + rh, r);
      ctx.lineTo(rx + r, ry + rh);
      ctx.arcTo(rx, ry + rh, rx, ry + rh - r, r);
      ctx.lineTo(rx, ry + r);
      ctx.arcTo(rx, ry, rx + r, ry, r);
      ctx.closePath();

      ctx.strokeStyle = AMBER + "44";
      ctx.lineWidth = 1;
      ctx.setLineDash([6, 6]);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.font = "14px 'Share Tech Mono', monospace";
      ctx.fillStyle = AMBER + "55"; ctx.textAlign = "center";
      ctx.fillText("datacenter / VPS", remoteX, ry + rh + 14);
    }

    function drawSharedLabel() {
      // Bottom label showing what syncs
      ctx.font = "14px 'Share Tech Mono', monospace";
      ctx.fillStyle = MUTED + "66"; ctx.textAlign = "center";
      ctx.fillText("reflections  \u00B7  bullpen posts  \u00B7  signals  \u00B7  kanban cards", W / 2, H - 18);
      ctx.fillText("sync via encrypted UDP broadcast (LAN) + WireGuard (WAN)", W / 2, H - 6);
    }

    function render() {
      t++;
      ctx.fillStyle = BG; ctx.fillRect(0, 0, W, H);

      const vg = ctx.createRadialGradient(W * 0.35, H * 0.45, 80, W * 0.35, H * 0.45, 500);
      vg.addColorStop(0, "#00102008"); vg.addColorStop(1, "#00000040");
      ctx.fillStyle = vg; ctx.fillRect(0, 0, W, H);

      drawLanBoundary();
      drawRemoteBoundary();
      drawLanConnections();
      drawTunnel();

      for (const node of lanNodes) drawNode(node);
      drawNode(remoteNode, true);

      drawSharedLabel();

      requestAnimationFrame(render);
    }

    render();
  }

  initArchCanvas();
  document.addEventListener("astro:after-swap", initArchCanvas);
</script>
