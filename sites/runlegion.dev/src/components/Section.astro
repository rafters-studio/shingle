---
import Container from "@/components/ui/container.astro";
import H2 from "@/components/ui/typography-h2.astro";

interface Props {
  id?: string;
  title?: string;
  tint?: boolean;
}

const { id, title, tint = false } = Astro.props;
---

<Container as="section" id={id} size="full" background={tint ? "muted" : "none"}>
  <Container size="4xl" padding="16" gap="12">
    {title && <H2>{title}</H2>}
    <slot />
  </Container>
</Container>
