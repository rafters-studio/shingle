---
import Base from './Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';

interface Props {
  title: string;
  description?: string;
}

// MDX pages deliver frontmatter under Astro.props.frontmatter; .astro pages
// pass props directly. Merge both so either entry point works.
const rawProps = Astro.props as Props & {
  frontmatter?: Partial<Props>;
};
const { title, description } = {
  ...rawProps.frontmatter,
  ...rawProps,
} as Props;

const currentPath = Astro.url.pathname;

const siteOrigin = Astro.site?.origin ?? 'https://runlegion.dev';
const pageUrl = new URL(currentPath, siteOrigin).href;

const techArticle: Record<string, unknown> = {
  '@type': 'TechArticle',
  '@id': `${pageUrl}#article`,
  headline: title,
  description,
  url: pageUrl,
  inLanguage: 'en',
  isPartOf: { '@id': `${siteOrigin}/#website` },
  publisher: { '@id': `${siteOrigin}/#organization` },
  about: { '@id': `${siteOrigin}/#software` },
};

const docsSections = [
  {
    title: 'Start',
    links: [
      { href: '/docs/', label: 'Overview' },
      { href: '/docs/getting-started/', label: 'Getting Started' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { href: '/docs/cli-reference/', label: 'CLI Reference' },
      { href: '/docs/plugin-guide/', label: 'Plugin Guide' },
    ],
  },
  {
    title: 'Deep Dive',
    links: [
      { href: '/docs/architecture/', label: 'Architecture' },
      { href: '/docs/concepts/', label: 'Concepts' },
    ],
  },
  {
    title: 'For LLMs',
    links: [
      { href: '/llms.txt', label: 'llms.txt' },
      { href: '/llms-full.txt', label: 'llms-full.txt' },
    ],
  },
];
---

<Base
  title={title}
  description={description}
  type="article"
  extraJsonLd={[techArticle]}
>
  <div class="docs-shell">
    <aside class="docs-sidebar">
      <nav class="docs-sidebar-nav" aria-label="Documentation">
        {docsSections.map((section) => (
          <div class="docs-nav-group">
            <span class="docs-group-title">{section.title}</span>
            {section.links.map((link) => {
              const isActive = currentPath === link.href;
              return (
                <a
                  href={link.href}
                  class:list={['docs-nav-item', isActive && 'docs-nav-active']}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        ))}
      </nav>
    </aside>
    <main class="docs-main">
      <Container size="full" as="article">
        <Grid preset="linear" columns={1}>
          <slot />
        </Grid>
      </Container>
    </main>
  </div>
</Base>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 13rem 1fr;
    min-height: calc(100vh - 8rem);
  }

  .docs-sidebar {
    border-right: 1px solid var(--border);
  }

  .docs-sidebar-nav {
    position: sticky;
    top: 0;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-height: 100vh;
    overflow-y: auto;
  }

  .docs-nav-group {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .docs-group-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--muted-foreground);
    margin-bottom: 0.375rem;
  }

  .docs-nav-item {
    display: block;
    font-family: 'Exo 2', sans-serif;
    font-size: 0.8125rem;
    color: var(--muted-foreground);
    text-decoration: none;
    padding: 0.1875rem 0;
    transition: color 0.15s;
  }

  .docs-nav-item:hover {
    color: var(--foreground);
  }

  .docs-nav-active {
    color: var(--primary);
    font-weight: 500;
  }

  .docs-main {
    min-width: 0;
  }
</style>
