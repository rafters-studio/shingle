---
import Container from "@/components/ui/container.astro";
import Grid from "@/components/ui/grid.astro";
import Small from "@/components/ui/typography-small.astro";
import MegaFooter from "@/components/MegaFooter.astro";

interface Props {
    title: string;
    description?: string;
    /** Absolute or site-relative URL for the social share image. */
    image?: string;
    /** OpenGraph content type. "article" for docs pages, "website" for everything else. */
    type?: "website" | "article";
    /** ISO 8601 timestamp for article published time (docs pages only). */
    publishedTime?: string;
    /** ISO 8601 timestamp for article last-modified time (docs pages only). */
    modifiedTime?: string;
    /** Additional JSON-LD nodes to merge into the sitewide graph. */
    extraJsonLd?: Record<string, unknown>[];
}

// MDX pages that set `layout: Base.astro` in frontmatter deliver their props
// under `Astro.props.frontmatter`. .astro pages pass them directly. Merge both
// so this layout works from either entry point.
const rawProps = Astro.props as Props & {
    frontmatter?: Partial<Props>;
};
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const {
    title,
    description = "Legion is a self-hosted AI agent orchestrator you own completely. Written in Rust. Free forever. No cloud required.",
    image = "/logo.svg",
    type = "website",
    publishedTime,
    modifiedTime,
    extraJsonLd = [],
} = merged;

const siteOrigin =
    Astro.site?.origin ?? "https://runlegion.dev";
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteImage = new URL(image, siteOrigin).href;
const fullTitle = `${title} | Legion`;

const navLinks = [
    { href: "#simple", label: "Overview" },
    { href: "#why", label: "Why" },
    { href: "#features", label: "Features" },
    { href: "#architecture", label: "Architecture" },
    { href: "/docs", label: "Docs" },
];

const linkClass = "no-underline text-muted-foreground hover:text-foreground";

// Sitewide JSON-LD: WebSite + Organization (Rafters Studio) + the home-page
// SoftwareApplication when on "/". Docs pages add a TechArticle node via the
// Docs layout so the graph stays per-page.
const isHome = Astro.url.pathname === "/";
const jsonLdGraph: Record<string, unknown>[] = [
    {
        "@type": "WebSite",
        "@id": `${siteOrigin}/#website`,
        url: `${siteOrigin}/`,
        name: "Legion",
        description:
            "Self-hosted orchestrator for AI coding agents. Memory, coordination, autonomy.",
        inLanguage: "en",
        publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
        "@type": "Organization",
        "@id": `${siteOrigin}/#organization`,
        name: "Rafters Studio",
        url: "https://rafters.studio",
        logo: `${siteOrigin}/logo.svg`,
    },
];
if (isHome) {
    jsonLdGraph.push({
        "@type": "SoftwareApplication",
        "@id": `${siteOrigin}/#software`,
        name: "Legion",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        description:
            "Self-hosted orchestrator for AI coding agents. Persistent memory, team coordination, multi-node LAN sync, kanban scheduler. Written in Rust. Free forever.",
        url: `${siteOrigin}/`,
        codeRepository: "https://github.com/runlegion/legion",
        programmingLanguage: "Rust",
        license: "https://opensource.org/licenses/MIT",
        offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
        },
        publisher: { "@id": `${siteOrigin}/#organization` },
    });
}
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [...jsonLdGraph, ...extraJsonLd],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{fullTitle}</title>
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content="#0a0a0a" />

        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <link rel="alternate icon" type="image/png" href="/mark.png" />
        <link rel="apple-touch-icon" href="/mark.png" />

        <meta property="og:site_name" content="Legion" />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:locale" content="en_US" />
        {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
        )}
        {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
        )}

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title="Legion docs index for LLMs"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms-full.txt"
            title="Legion docs (full) for LLMs"
        />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    </head>
    <body class="bg-background text-foreground">
        <header
            id="site-header"
            class="border-b border-border bg-background"
            style="position:fixed;top:0;left:0;right:0;z-index:50;opacity:0;pointer-events:none;transition:opacity 0.2s ease"
        >
            <Container size="6xl" padding="4">
                <Grid preset="linear" columns={2} gap="6">
                    <a href="/" aria-label="Legion home" class="no-underline">
                        <img
                            src="/logo.svg"
                            alt="Legion"
                            width="160"
                            height="24"
                        />
                    </a>
                    <Grid
                        preset="linear"
                        columns={6}
                        gap="6"
                        class="text-end"
                    >
                        {
                            navLinks.map((link) => (
                                <a href={link.href} class={linkClass}>
                                    <Small>{link.label}</Small>
                                </a>
                            ))
                        }
                        <a
                            href="https://github.com/runlegion/legion"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="GitHub repository"
                            class={linkClass}
                        >
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                height="20"
                                aria-hidden="true"
                            >
                                <path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path>
                                <path d="M9 18c-4.51 2-5-2-7-2"></path>
                            </svg>
                        </a>
                    </Grid>
                </Grid>
            </Container>
        </header>

        <main>
            <slot />
        </main>

        <MegaFooter />
        <script is:inline>
            (function () {
                var header = document.getElementById("site-header");
                if (!header) return;
                function updateNav() {
                    var show = window.scrollY > window.innerHeight * 0.8;
                    header.style.opacity = show ? "1" : "0";
                    header.style.pointerEvents = show ? "auto" : "none";
                }
                window.addEventListener("scroll", updateNav, { passive: true });
            })();
        </script>
    </body>
</html>

<style is:global>
    @import "../styles/global.css";

    :root {
        --font-sans:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-heading:
            "IBM Plex Sans Condensed", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-body:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-code:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
        --font-mono:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
    }
</style>
