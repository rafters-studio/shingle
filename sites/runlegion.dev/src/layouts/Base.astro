---
import Container from "@/components/ui/container.astro";
import Grid from "@/components/ui/grid.astro";
import Small from "@/components/ui/typography-small.astro";
import MegaFooter from "@/components/MegaFooter.astro";
import SiteHead from "@shingle/shared/SiteHead.astro";
import TopBar from "@shingle/shared/TopBar.astro";
import { softwareApplication, RAFTERS_STUDIO } from "@shingle/shared/meta";
import type { JsonLdObject } from "@shingle/shared/meta";

interface Props {
    title: string;
    description?: string;
    /** Absolute or site-relative URL for the social share image. */
    image?: string;
    /** OpenGraph content type. "article" for docs pages, "website" for everything else. */
    type?: "website" | "article";
    /** ISO 8601 timestamp for article published time (docs pages only). */
    publishedTime?: string;
    /** ISO 8601 timestamp for article last-modified time (docs pages only). */
    modifiedTime?: string;
    /** Additional per-page JSON-LD nodes merged into the shared graph. */
    extraJsonLd?: JsonLdObject[];
}

// MDX pages that set `layout: Base.astro` in frontmatter deliver their props
// under `Astro.props.frontmatter`. .astro pages pass them directly. Merge both
// so this layout works from either entry point.
const rawProps = Astro.props as Props & {
    frontmatter?: Partial<Props>;
};
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const {
    title,
    description = "Legion is a self-hosted AI agent orchestrator you own completely. Written in Rust. Free forever. No cloud required.",
    image = "/logo.svg",
    type = "website",
    publishedTime,
    modifiedTime,
    extraJsonLd = [],
} = merged;

const siteOrigin =
    Astro.site?.origin ?? "https://runlegion.dev";
const fullTitle = `${title} | Legion`;

const navLinks = [
    { href: "#simple", label: "Overview" },
    { href: "#why", label: "Why" },
    { href: "#features", label: "Features" },
    { href: "#architecture", label: "Architecture" },
    { href: "/docs", label: "Docs" },
];

// The shared SiteHead emits the WebSite + Rafters Studio Organization graph.
// This layout adds only the site-specific nodes: the SoftwareApplication on the
// home page, plus any per-page node a child layout passes (the docs TechArticle).
// They reference the studio org by its shared @id so the merged graph resolves.
const isHome = Astro.url.pathname === "/";
const softwareApp: JsonLdObject = {
    ...softwareApplication({
        "@id": `${siteOrigin}/#software`,
        name: "Legion",
        url: `${siteOrigin}/`,
        description:
            "Self-hosted orchestrator for AI coding agents. Persistent memory, team coordination, multi-node LAN sync, kanban scheduler. Written in Rust. Free forever.",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        offers: { price: "0", priceCurrency: "USD" },
    }),
    codeRepository: "https://github.com/runlegion/legion",
    programmingLanguage: "Rust",
    license: "https://opensource.org/licenses/MIT",
    publisher: { "@id": RAFTERS_STUDIO.id },
};
const extraSchema: JsonLdObject[] = [...(isHome ? [softwareApp] : []), ...extraJsonLd];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{fullTitle}</title>
        <meta name="theme-color" content="#0a0a0a" />

        <SiteHead
            title={fullTitle}
            description={description}
            ogType={type}
            image={image}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            extraSchema={extraSchema}
        />

        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <link rel="alternate icon" type="image/png" href="/mark.png" />
        <link rel="apple-touch-icon" href="/mark.png" />

        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title="Legion docs index for LLMs"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms-full.txt"
            title="Legion docs (full) for LLMs"
        />

    </head>
    <body class="bg-background text-foreground">
        <TopBar name="Legion" links={navLinks} />

        <main>
            <slot />
        </main>

        <MegaFooter />
    </body>
</html>

<style is:global>
    @import "../styles/global.css";

    :root {
        --font-sans:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-heading:
            "IBM Plex Sans Condensed", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-body:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-code:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
        --font-mono:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
    }
</style>
