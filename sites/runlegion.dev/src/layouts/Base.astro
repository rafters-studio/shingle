---
import Container from "@/components/ui/container.astro";
import Grid from "@/components/ui/grid.astro";
import Small from "@/components/ui/typography-small.astro";
import LogoArt from "@/components/LogoArt.astro";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Legion is a self-hosted AI agent orchestrator you own completely. Written in Rust. Free forever. No cloud required.",
} = Astro.props;

const navLinks = [
    { href: "#simple", label: "Overview" },
    { href: "#why", label: "Why" },
    { href: "#features", label: "Features" },
    { href: "#architecture", label: "Architecture" },
];

const linkClass = "no-underline text-muted-foreground hover:text-foreground";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title} | Legion</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-background text-foreground">
        <header class="border-b border-border">
            <Container size="6xl" padding="4">
                <Grid preset="linear" columns={2} gap="6">
                    <a href="/" aria-label="Legion home" class="no-underline">
                        <img src="/logo.svg" alt="Legion" width="160" height="24" />
                    </a>
                    <Grid preset="linear" columns={navLinks.length + 1} gap="6" class="text-end">
                        {
                            navLinks.map((link) => (
                                <a
                                    href={link.href}
                                    class={linkClass}
                                >
                                    <Small>{link.label}</Small>
                                </a>
                            ))
                        }
                        <a
                            href="https://github.com/runlegion/legion"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="GitHub repository"
                            class={linkClass}
                        >
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                height="20"
                                aria-hidden="true"
                            >
                                <path
                                    d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                ></path>
                                <path d="M9 18c-4.51 2-5-2-7-2"></path>
                            </svg>
                        </a>
                    </Grid>
                </Grid>
            </Container>
        </header>

        <main>
            <slot />
        </main>

        <footer class="border-t border-border">
            <Container size="4xl" padding="12">
                <Container gap="4">
                    <LogoArt height="2rem" />
                    <Small>
                        Legion &middot; Free and open source &middot; MIT licensed
                    </Small>
                    <Grid preset="linear" columns={2} gap="4">
                        <a
                            href="https://github.com/runlegion/legion"
                            target="_blank"
                            rel="noopener noreferrer"
                            class={linkClass}
                        >
                            <Small>GitHub</Small>
                        </a>
                        <a
                            href="https://rafters.studio"
                            target="_blank"
                            rel="noopener noreferrer"
                            class={linkClass}
                        >
                            <Small>A Rafters Studio project</Small>
                        </a>
                    </Grid>
                </Container>
            </Container>
        </footer>
    </body>
</html>

<style is:global>
    @import "../styles/global.css";

    :root {
        --font-sans: "IBM Plex Sans", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-heading: "IBM Plex Sans Condensed", -apple-system,
            BlinkMacSystemFont, "Segoe UI", sans-serif;
        --font-body: "IBM Plex Sans", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-code: "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code",
            monospace;
        --font-mono: "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code",
            monospace;
    }
</style>
