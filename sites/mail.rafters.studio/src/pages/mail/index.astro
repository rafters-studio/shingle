---
import Base from '@/src/layouts/Base.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import Hero from '@/components/Hero.astro';
import ArchitectureSection from '@/components/ArchitectureSection.astro';
import ModulesSection from '@/components/ModulesSection.astro';
import WhyEdgeSection from '@/components/WhyEdgeSection.astro';
import ComparisonSection from '@/components/ComparisonSection.astro';
import FaqSection from '@/components/FaqSection.astro';
import OssCallout from '@/components/OssCallout.astro';
---

<Base title="Edge-native email" description="A full-stack email framework for Cloudflare Workers. Inbound, outbound, threading, blob storage, classification, and a native IMAP server.">
  <SiteHeader />
  <main>
    <Hero />
    <ArchitectureSection />
    <ModulesSection />
    <WhyEdgeSection />
    <ComparisonSection />
