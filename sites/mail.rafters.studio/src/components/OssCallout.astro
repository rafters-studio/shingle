---
import Container from '@/components/ui/container.astro';
import H3 from '@/components/ui/typography-h3.astro';
import P from '@/components/ui/typography-p.astro';
import LinkButton from '@/components/composites/LinkButton.astro';

const repo = 'https://github.com/rafters-studio/mail';
---

<section id="oss" class="border-b border-border">
  <Container size="6xl" padding="20">
    <div class="border border-border bg-background rounded-md p-8">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:items-center">
        <div class="flex flex-col gap-3">
          <H3 size="title-large" tracking="tight" class="m-0">
            Open source.
            <span class="font-mono border-b-2 border-foreground pb-0.5">MIT</span>.
          </H3>
          <P size="body-medium" color="muted-foreground" class="max-w-prose m-0">
            The whole thing lives at <code class="font-mono">rafters-studio/mail</code>. Issues welcome.
            RFC nitpicks especially welcome.
          </P>
        </div>

        <div class="flex flex-col items-start gap-3 lg:items-end">
          <a
            href={repo}
            class="inline-flex items-center gap-2 border border-border rounded-sm px-3 py-2 font-mono text-label-small text-muted-foreground hover:text-foreground hover:border-foreground no-underline transition-colors"
          >
            <span aria-hidden="true">★</span>
            <strong class="text-foreground">rafters-studio / mail</strong>
            <span aria-hidden="true">↗</span>
          </a>
          <LinkButton href={repo} variant="outline" external>View on GitHub</LinkButton>
        </div>
      </div>
    </div>
  </Container>
</section>
