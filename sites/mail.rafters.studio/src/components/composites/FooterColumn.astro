---
interface Link {
  href: string;
  label: string;
}

interface Props {
  heading: string;
  links: Link[];
}

const { heading, links } = Astro.props;
---

<div class="flex flex-col gap-3">
  <h4 class="font-mono text-label-small uppercase tracking-wide text-muted-foreground m-0">{heading}</h4>
  <ul class="flex flex-col gap-2 list-none p-0 m-0">
    {links.map(({ href, label }) => (
      <li>
        <a href={href} class="text-body-small text-muted-foreground hover:text-foreground no-underline">{label}</a>
      </li>
    ))}
  </ul>
</div>
