---
import Card from '@/components/ui/card.astro';
import Tabs from '@/components/ui/tabs.astro';
import TabsContent from '@/components/ui/tabs-content.astro';
import TabsList from '@/components/ui/tabs-list.astro';
import TabsTrigger from '@/components/ui/tabs-trigger.astro';
import Button from '@/components/ui/button.astro';

interface Cmd {
  pkg: 'npm' | 'pnpm' | 'bun' | 'deno';
  cmd: string;
}

interface Props {
  primary: Cmd[];
  followUps: string[];
  footline?: { label: string; value: string }[];
}

const { primary, followUps, footline = [] } = Astro.props;
const tabsId = 'install';
const defaultPkg = primary[0]?.pkg ?? 'pnpm';
---

<Card class="overflow-hidden">
  <Tabs id={tabsId} defaultValue={defaultPkg}>
    <TabsList class="border-b border-border bg-card">
      {primary.map((c) => (
        <TabsTrigger tabsId={tabsId} value={c.pkg} defaultChecked={c.pkg === defaultPkg}>
          {c.pkg}
        </TabsTrigger>
      ))}
    </TabsList>

    {primary.map((c) => {
      const targetId = `install-cmd-${c.pkg}`;
      return (
        <TabsContent
          tabsId={tabsId}
          value={c.pkg}
          defaultActive={c.pkg === defaultPkg}
          class="relative bg-neutral-950 text-neutral-100 p-6 font-mono text-body-small leading-loose"
        >
          <Button variant="outline" size="sm" class="absolute top-4 right-4" data-copy-target={`#${targetId}`}>
            COPY
          </Button>

          <div class="text-neutral-500"># one package, drop into any Workers project</div>
          <div>
            <span class="text-foreground mr-2">$</span>
            <span id={targetId}>{c.cmd}</span>
          </div>

          {followUps.map((cmd, i) => (
            <div class="mt-4">
              <div class="text-neutral-500">
                {i === 0 ? '# wire it up' : '# receive your first email'}
              </div>
              <div>
                <span class="text-foreground mr-2">$</span>
                <span>{cmd}</span>
              </div>
            </div>
          ))}
        </TabsContent>
      );
    })}
  </Tabs>

  {footline.length > 0 && (
    <div class="flex flex-wrap gap-6 border-t border-border bg-card px-6 py-3 font-mono text-label-small uppercase tracking-wide text-muted-foreground">
      {footline.map(({ label, value }) => (
        <span>{label} <span class="text-foreground">{value}</span></span>
      ))}
    </div>
  )}
</Card>

<script is:inline>
  document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var sel = btn.getAttribute('data-copy-target');
      var el = sel ? document.querySelector(sel) : null;
      if (!el || !navigator.clipboard) return;
      navigator.clipboard.writeText(el.textContent || '').then(function () {
        var prev = btn.textContent;
        btn.textContent = 'COPIED';
        setTimeout(function () {
          btn.textContent = prev;
        }, 1200);
      });
    });
  });
</script>
