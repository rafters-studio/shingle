---
import Card from '@/components/ui/card.astro';
import H3 from '@/components/ui/typography-h3.astro';

interface Props {
  pathHead: string;
  pathTail: string;
  title: string;
}

const { pathHead, pathTail, title } = Astro.props;
---

<Card class="flex flex-col gap-4 p-6 min-h-56 h-full">
  <div class="font-mono text-label-small uppercase tracking-wide text-muted-foreground">
    <span class="text-foreground">{pathHead}</span>
    <span> / {pathTail}</span>
  </div>
  <H3 size="title-medium" tracking="tight" class="m-0">{title}</H3>
  <div class="text-body-small text-muted-foreground">
    <slot name="description" />
  </div>
  <div class="flex flex-wrap gap-2 mt-auto">
    <slot name="intel" />
  </div>
</Card>
