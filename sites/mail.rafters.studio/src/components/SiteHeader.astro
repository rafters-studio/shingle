---
import Container from '@/components/ui/container.astro';
import Brand from '@/components/composites/Brand.astro';
import LinkButton from '@/components/composites/LinkButton.astro';

const githubUrl = 'https://github.com/rafters-studio/mail';

const navLinks = [
  { href: '#architecture', label: 'Architecture' },
  { href: '#modules', label: 'Modules' },
  { href: '#why', label: 'Why edge' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="sticky top-0 z-50 border-b border-border bg-background">
  <Container size="6xl" padding="4">
    <div class="flex items-center justify-between gap-6">
      <Brand href="#" />

      <nav class="flex items-center gap-6">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class="hidden text-label-medium text-muted-foreground hover:text-foreground transition-colors no-underline md:inline"
          >
            {label}
          </a>
        ))}
        <LinkButton href={githubUrl} size="sm" external>
          GitHub <span aria-hidden="true">↗</span>
        </LinkButton>
      </nav>
    </div>
  </Container>
</header>
