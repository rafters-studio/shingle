---
import Container from '@/components/ui/container.astro';
import P from '@/components/ui/typography-p.astro';

const docs = [
  { href: '#', label: 'Getting started' },
  { href: '#', label: 'Architecture' },
  { href: '#', label: 'Core reference' },
  { href: '#', label: 'Migrations' },
];

const imap = [
  { href: '#', label: 'Quickstart' },
  { href: '#', label: 'Command reference' },
  { href: '#', label: 'App passwords' },
  { href: '#', label: 'Deployment' },
];

const project = [
  { href: 'https://github.com/rafters-studio/mail', label: 'GitHub ↗' },
  { href: '#', label: 'Changelog' },
  { href: '#', label: 'Roadmap' },
  { href: '#', label: 'License (MIT)' },
];
---

<footer class="border-t border-border bg-background">
  <Container size="6xl" padding="16">
    <div class="grid grid-cols-2 gap-12 md:grid-cols-4">
      <div class="col-span-2 flex flex-col gap-4 md:col-span-1">
        <a href="#" class="flex items-center gap-3 text-foreground no-underline">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 374 227"
            class="h-6 w-auto"
            aria-hidden="true"
          >
            <path
              d="m373.584 101.144-5.244 12.98L209.155 49.81l.07.17-203.98 82.414L0 119.413l190.715-77.055L118 12.981 123.244 0l250.34 101.144Z"
            />
          </svg>
          <span class="font-mono text-label-medium font-medium">
            <span class="text-muted-foreground">@rafters/</span>mail
          </span>
        </a>
        <P size="body-small" color="muted-foreground" class="max-w-prose m-0">
          A full-stack email framework for Cloudflare Workers. By
          <a href="https://rafters.studio" class="text-foreground hover:underline">Real Handy</a>.
        </P>
      </div>

      <div class="flex flex-col gap-3">
        <h4 class="font-mono text-label-small uppercase tracking-wide text-muted-foreground m-0">Docs</h4>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          {docs.map(({ href, label }) => (
            <li><a href={href} class="text-body-small text-muted-foreground hover:text-foreground no-underline">{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h4 class="font-mono text-label-small uppercase tracking-wide text-muted-foreground m-0">IMAP</h4>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          {imap.map(({ href, label }) => (
            <li><a href={href} class="text-body-small text-muted-foreground hover:text-foreground no-underline">{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col gap-3">
        <h4 class="font-mono text-label-small uppercase tracking-wide text-muted-foreground m-0">Project</h4>
        <ul class="flex flex-col gap-2 list-none p-0 m-0">
          {project.map(({ href, label }) => (
            <li><a href={href} class="text-body-small text-muted-foreground hover:text-foreground no-underline">{label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-border pt-6 mt-12 font-mono text-label-small uppercase tracking-wide text-muted-foreground md:flex-row md:justify-between">
      <span>© 2026 Real Handy · built on Rafters</span>
      <span>v0.1.0-alpha · commit a3f91c2</span>
    </div>
  </Container>
</footer>
