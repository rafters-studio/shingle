---
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';

interface Props {
  title: string;
  description?: string;
  heroSlot?: boolean;
}

const { title, description = 'Sean Silvius - UI designer and software architect. Writing about design systems, service design, and building software.', heroSlot = false } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Index' },
  { href: '/posts/', label: 'Software' },
  { href: '/night-shift/', label: 'Night Shift' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    {heroSlot ? (
      <div class="bg-primary text-primary-foreground">
        <header>
          <nav aria-label="Main navigation">
            <Container size="5xl" padding="6" class="py-4">
              <div class="flex items-center justify-between">
                <a href="/" class="text-xs font-semibold tracking-widest uppercase text-primary-foreground no-underline">
                  sean.silvius.me
                </a>
                <div class="flex items-center gap-6">
                  {navLinks.map((link) => (
                    <a
                      href={link.href}
                      class:list={[
                        'text-xs uppercase tracking-wider no-underline transition-colors',
                        currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                          ? 'text-primary-foreground font-semibold'
                          : 'text-primary-foreground/70 hover:text-primary-foreground',
                      ]}
                      aria-current={currentPath === link.href ? 'page' : undefined}
                    >
                      {link.label}
                    </a>
                  ))}
                  <a
                    href="/connect/"
                    class="text-xs uppercase tracking-wider no-underline border border-primary-foreground/50 rounded px-3 py-1.5 text-primary-foreground/90 hover:bg-primary-foreground/10 transition-colors"
                  >
                    Connect
                  </a>
                </div>
              </div>
            </Container>
          </nav>
        </header>
        <slot name="hero" />
      </div>
    ) : (
      <header class="bg-primary text-primary-foreground">
        <nav aria-label="Main navigation">
          <Container size="5xl" padding="6" class="py-4">
            <div class="flex items-center justify-between">
              <a href="/" class="text-xs font-semibold tracking-widest uppercase text-primary-foreground no-underline">
                sean.silvius.me
              </a>
              <div class="flex items-center gap-6">
                {navLinks.map((link) => (
                  <a
                    href={link.href}
                    class:list={[
                      'text-xs uppercase tracking-wider no-underline transition-colors',
                      currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                        ? 'text-primary-foreground font-semibold'
                        : 'text-primary-foreground/70 hover:text-primary-foreground',
                    ]}
                    aria-current={currentPath === link.href ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                ))}
                <a
                  href="/connect/"
                  class="text-xs uppercase tracking-wider no-underline border border-primary-foreground/50 rounded px-3 py-1.5 text-primary-foreground/90 hover:bg-primary-foreground/10 transition-colors"
                >
                  Connect
                </a>
              </div>
            </div>
          </Container>
        </nav>
      </header>
    )}

    <slot />

    <footer class="bg-primary text-primary-foreground mt-20">
      <Container size="5xl" padding="6" class="py-12">
        <Grid preset="linear" columns={4} gap="8">
          <div>
            <p class="text-sm font-semibold mb-3">Bio</p>
            <p class="text-sm text-primary-foreground/70 leading-relaxed">
              UI designer and software architect since 1993. I build design systems, write about service design, and make mistakes worth learning from.
            </p>
          </div>
          <div>
            <nav class="flex flex-col gap-2" aria-label="Site navigation">
              <a href="/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Home</a>
              <a href="/posts/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Articles</a>
              <a href="/posts/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Software</a>
              <a href="/night-shift/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Night Shift</a>
              <a href="/connect/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Connect</a>
            </nav>
          </div>
          <div>
            <p class="text-sm font-semibold mb-3">Connect</p>
            <nav class="flex flex-col gap-2" aria-label="Social links">
              <a href="https://github.com/ssilvius" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">GitHub</a>
              <a href="https://linkedin.com/in/seansilvius" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">LinkedIn</a>
            </nav>
          </div>
          <div>
            <p class="text-sm font-semibold mb-3">Legal</p>
            <nav class="flex flex-col gap-2" aria-label="Legal links">
              <a href="/privacy/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Privacy Policy</a>
              <a href="/terms/" class="text-sm text-primary-foreground/70 hover:text-primary-foreground no-underline transition-colors">Terms of Service</a>
            </nav>
          </div>
        </Grid>
        <div class="border-t border-primary-foreground/20 mt-8 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2">
          <p class="text-xs text-primary-foreground/50">
            &copy; {new Date().getFullYear()} Sean Silvius. All rights reserved.
          </p>
          <p class="text-xs text-primary-foreground/50">
            Built with love in the PNW.
          </p>
        </div>
      </Container>
    </footer>
  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
