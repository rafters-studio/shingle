---
import { ClientRouter, fade } from 'astro:transitions';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
import Separator from '@/src/components/ui/separator.astro';
import Topbar from '@/src/components/Topbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sean Silvius',
  description = 'Articles on software engineering, product design, startups, and gaming from Sean Silvius.',
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://sean.silvius.me';
const fullTitle = title === 'Sean Silvius' ? title : `${title} | Sean Silvius`;

const footerColumns = [
  {
    heading: 'Site',
    links: [
      { href: '/', label: 'Home' },
      { href: '/posts/', label: 'Articles' },
      { href: '/software/', label: 'Software' },
      { href: '/night-shift/', label: 'Night Shift' },
      { href: '/connect/', label: 'Connect' },
    ],
  },
  {
    heading: 'Connect',
    links: [
      { href: 'https://github.com/ssilvius', label: 'GitHub', external: true },
      { href: 'https://www.linkedin.com/in/seansilvius/', label: 'LinkedIn', external: true },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy Policy' },
      { href: '/terms/', label: 'Terms of Service' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sean Silvius" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/profile.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ssilvius" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground">

    <Topbar />

    <main transition:animate={fade({ duration: '0.15s' })}>
      <slot />
    </main>

    <footer class="bg-primary text-primary-foreground">
      <Container size="7xl">
        <Grid preset="linear" columns={3} gap="8">
          {footerColumns.map((col) => (
            <Container gap="3">
              <Typography as="h3" variant="h4" class="text-secondary">{col.heading}</Typography>
              <Container gap="2">
                {col.links.map((link) => (
                  <a
                    href={link.href}
                    class="no-underline text-primary-foreground hover:text-secondary"
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                  </a>
                ))}
              </Container>
            </Container>
          ))}
        </Grid>
        <Separator class="bg-primary-foreground/20" />
        <Grid preset="linear" columns={2}>
          <Typography as="p" variant="muted" class="text-primary-foreground/60">&copy; 2026 Sean Silvius. All rights reserved.</Typography>
          <Typography as="p" variant="muted" class="text-primary-foreground/60 text-end">Built with love in the PNW</Typography>
        </Grid>
      </Container>
    </footer>

  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
