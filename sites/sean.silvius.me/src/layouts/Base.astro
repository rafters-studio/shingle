---
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
import Separator from '@/src/components/ui/separator.astro';

interface Props {
  title: string;
  description?: string;
  heroSlot?: boolean;
}

const { title, description = 'Sean Silvius - UI designer and software architect. Writing about design systems, service design, and building software.', heroSlot = false } = Astro.props;

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Index' },
  { href: '/posts/', label: 'Software' },
  { href: '/night-shift/', label: 'Night Shift' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-background text-foreground">
    {heroSlot ? (
      <div class="bg-primary text-primary-foreground">
        <header>
          <nav aria-label="Main navigation">
            <Container size="5xl" padding="6">
              <Grid preset="linear" columns={2}>
                <a href="/" class="no-underline">
                  <Typography as="span" variant="small" class="tracking-widest uppercase text-primary-foreground">
                    sean.silvius.me
                  </Typography>
                </a>
                <Grid preset="linear" columns={4} gap="6" class="text-end">
                  {navLinks.map((link) => (
                    <a
                      href={link.href}
                      class:list={[
                        'no-underline uppercase tracking-wider',
                        currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                          ? 'text-primary-foreground'
                          : 'text-primary-foreground/70 hover:text-primary-foreground',
                      ]}
                      aria-current={currentPath === link.href ? 'page' : undefined}
                    >
                      <Typography as="span" variant="small">{link.label}</Typography>
                    </a>
                  ))}
                  <a
                    href="/connect/"
                    class="no-underline uppercase tracking-wider text-primary-foreground/90 border border-primary-foreground/50 rounded"
                  >
                    <Typography as="span" variant="small">Connect</Typography>
                  </a>
                </Grid>
              </Grid>
            </Container>
          </nav>
        </header>
        <slot name="hero" />
      </div>
    ) : (
      <header class="bg-primary text-primary-foreground">
        <nav aria-label="Main navigation">
          <Container size="5xl" padding="6">
            <Grid preset="linear" columns={2}>
              <a href="/" class="no-underline">
                <Typography as="span" variant="small" class="tracking-widest uppercase text-primary-foreground">
                  sean.silvius.me
                </Typography>
              </a>
              <Grid preset="linear" columns={4} gap="6" class="text-end">
                {navLinks.map((link) => (
                  <a
                    href={link.href}
                    class:list={[
                      'no-underline uppercase tracking-wider',
                      currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                        ? 'text-primary-foreground'
                        : 'text-primary-foreground/70 hover:text-primary-foreground',
                    ]}
                    aria-current={currentPath === link.href ? 'page' : undefined}
                  >
                    <Typography as="span" variant="small">{link.label}</Typography>
                  </a>
                ))}
                <a
                  href="/connect/"
                  class="no-underline uppercase tracking-wider text-primary-foreground/90 border border-primary-foreground/50 rounded"
                >
                  <Typography as="span" variant="small">Connect</Typography>
                </a>
              </Grid>
            </Grid>
          </Container>
        </nav>
      </header>
    )}

    <slot />

    <footer class="bg-primary text-primary-foreground">
      <Container size="5xl" padding="6">
        <Grid preset="linear" columns={4} gap="8">
          <div>
            <Typography as="p" variant="small" class="text-primary-foreground">Bio</Typography>
            <Typography as="p" variant="muted" class="text-primary-foreground/70">
              UI designer and software architect since 1993. I build design systems, write about service design, and make mistakes worth learning from.
            </Typography>
          </div>
          <nav aria-label="Site navigation">
            <Container gap="2">
              <a href="/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Home</Typography></a>
              <a href="/posts/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Articles</Typography></a>
              <a href="/posts/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Software</Typography></a>
              <a href="/night-shift/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Night Shift</Typography></a>
              <a href="/connect/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Connect</Typography></a>
            </Container>
          </nav>
          <div>
            <Typography as="p" variant="small" class="text-primary-foreground">Connect</Typography>
            <Container gap="2">
              <a href="https://github.com/ssilvius" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">GitHub</Typography></a>
              <a href="https://linkedin.com/in/seansilvius" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">LinkedIn</Typography></a>
            </Container>
          </div>
          <div>
            <Typography as="p" variant="small" class="text-primary-foreground">Legal</Typography>
            <Container gap="2">
              <a href="/privacy/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Privacy Policy</Typography></a>
              <a href="/terms/" class="no-underline text-primary-foreground/70 hover:text-primary-foreground"><Typography as="span" variant="muted">Terms of Service</Typography></a>
            </Container>
          </div>
        </Grid>
        <Separator class="bg-primary-foreground/20" />
        <Grid preset="linear" columns={2}>
          <Typography as="p" variant="small" class="text-primary-foreground/50">
            &copy; {new Date().getFullYear()} Sean Silvius. All rights reserved.
          </Typography>
          <Typography as="p" variant="small" class="text-primary-foreground/50 text-end">
            Built with love in the PNW.
          </Typography>
        </Grid>
      </Container>
    </footer>
  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
