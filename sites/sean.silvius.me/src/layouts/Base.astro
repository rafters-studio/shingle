---
import { ClientRouter, fade } from 'astro:transitions';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import H3 from '@/src/components/ui/typography-h3.astro';
import P from '@/src/components/ui/typography-p.astro';
import Separator from '@/src/components/ui/separator.astro';
import Topbar from '@/src/components/Topbar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sean Silvius',
  description = 'Articles on software engineering, product design, startups, and gaming from Sean Silvius.',
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://sean.silvius.me';
const fullTitle = title === 'Sean Silvius' ? title : `${title} | Sean Silvius`;

const footerColumns = [
  {
    heading: 'Site',
    links: [
      { href: '/', label: 'Home' },
      { href: '/posts/', label: 'Articles' },
      { href: '/software/', label: 'Software' },
      { href: '/night-shift/', label: 'Night Shift' },
      { href: '/connect/', label: 'Connect' },
    ],
  },
  {
    heading: 'Connect',
    links: [
      { href: 'https://github.com/ssilvius', label: 'GitHub', external: true },
      { href: 'https://www.linkedin.com/in/seansilvius/', label: 'LinkedIn', external: true },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy/', label: 'Privacy Policy' },
      { href: '/terms/', label: 'Terms of Service' },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sean Silvius" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}${Astro.url.pathname}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/images/profile.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ssilvius" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${siteUrl}${Astro.url.pathname}`} />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground">

    <Topbar />

    <main transition:animate={fade({ duration: '0.15s' })}>
      <slot />
    </main>

    <footer class="bg-primary text-primary-foreground border-t border-border">
      <Container size="7xl">
        <Grid preset="linear" columns={3} gap="8">
          {footerColumns.map((col) => (
            <Container gap="3">
              <H3 size="xl" color="secondary">{col.heading}</H3>
              <Container gap="2">
                {col.links.map((link) => (
                  <a
                    href={link.href}
                    class="no-underline text-primary-foreground hover:text-secondary transition-colors duration-fast"
                    {...('external' in link && link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                  </a>
                ))}
              </Container>
            </Container>
          ))}
        </Grid>
        <Separator class="bg-primary-foreground/20" />
        <Grid preset="linear" columns={2}>
          <P size="sm" color="primary-foreground">&copy; 2026 Sean Silvius. All rights reserved.</P>
          <P size="sm" color="primary-foreground">Built with love in the PNW <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline text-success"><path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M16 14v.2A3 3 0 0 1 14.9 20H11a3 3 0 0 1-1-5.8V14a3 3 0 0 1 6 0"/></svg></P>
        </Grid>
      </Container>
    </footer>

  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
