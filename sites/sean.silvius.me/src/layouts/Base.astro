---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Sean Silvius - UI designer and software architect. Writing about design systems, service design, and building software.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground">
    <slot />
  </body>
</html>

<style>
  @import '../styles/global.css';
</style>
