---
export const prerender = true;

import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
---

<Base title="Connect" description="Get in touch with Sean Silvius.">
  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <Typography as="h1" variant="h1">Connect</Typography>
      <Typography as="p" variant="lead">Want to chat? Reach out on any of these platforms.</Typography>
    </Grid>
  </Container>

  <Container size="5xl">
    <Grid preset="linear" columns={2} gap="6">
      <Container gap="2">
        <Typography as="h2" variant="h3">GitHub</Typography>
        <Typography as="p" variant="p"><a href="https://github.com/ssilvius" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">github.com/ssilvius</a></Typography>
      </Container>
      <Container gap="2">
        <Typography as="h2" variant="h3">LinkedIn</Typography>
        <Typography as="p" variant="p"><a href="https://www.linkedin.com/in/seansilvius/" target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-4">linkedin.com/in/seansilvius</a></Typography>
      </Container>
    </Grid>
  </Container>
</Base>
