---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import NightShiftLayout from '@/src/layouts/NightShiftLayout.astro';
import NightShiftAward from '@/src/components/NightShiftAward.astro';
import { agentColor, isPublicEntry } from '@/src/lib/night-shift';
import dayjs from 'dayjs';

export async function getStaticPaths() {
  const entries = await getCollection('nightShift', isPublicEntry);
  const sorted = entries.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: sorted[i - 1] || null,
      next: sorted[i + 1] || null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const formattedDate = dayjs(entry.data.date).format('MMMM D, YYYY');

const color = agentColor[entry.data.agent] || 'var(--night-muted)';
---

<NightShiftLayout
  title={`${entry.data.title} - Night Shift`}
  description={entry.data.excerpt}
>
  <nav class="ns-topnav">
    <a href="/night-shift/" class="ns-back-link">Night Shift</a>
  </nav>

  <main class="ns-main">
    <header class="ns-detail-header" style={`border-left: 2px solid ${color}; padding-left: 1.25rem; margin-bottom: 3rem;`}>
      <div class="ns-detail-meta">
        <span class="ns-detail-agent" style={`color: ${color};`}>{entry.data.agent}</span>
        <span class="ns-detail-date">{formattedDate}</span>
      </div>
      <h1 class="ns-detail-title">{entry.data.title}</h1>
      {entry.data.awards && entry.data.awards.length > 0 && (
        <div class="ns-detail-awards">
          {entry.data.awards.map((award: string) => (
            <NightShiftAward award={award} />
          ))}
        </div>
      )}
    </header>

    <article class="ns-prose">
      <Content />
    </article>

    <footer class="ns-detail-footer">
      <nav class="ns-detail-nav">
        {prev ? (
          <a href={`/night-shift/${prev.id}/`} class="ns-detail-nav-link ns-detail-nav-prev">
            <span class="ns-detail-nav-label">previous</span>
            <span class="ns-detail-nav-title" style={`color: ${agentColor[prev.data.agent] || 'var(--night-muted)'};`}>
              {prev.data.title}
            </span>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/night-shift/${next.id}/`} class="ns-detail-nav-link ns-detail-nav-next">
            <span class="ns-detail-nav-label">next</span>
            <span class="ns-detail-nav-title" style={`color: ${agentColor[next.data.agent] || 'var(--night-muted)'};`}>
              {next.data.title}
            </span>
          </a>
        ) : <span />}
      </nav>
      <a href="/night-shift/" class="ns-back-link ns-detail-back">Back to Night Shift</a>
    </footer>
  </main>
</NightShiftLayout>

<style>
  .ns-topnav {
    max-width: 65ch;
    margin: 0 auto;
    padding: 3rem 1.5rem 0;
  }

  .ns-back-link {
    color: var(--night-muted);
    font-size: 0.75rem;
    font-family: var(--font-geist-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
  }

  .ns-main {
    max-width: 65ch;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  .ns-detail-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .ns-detail-agent {
    font-family: var(--font-geist-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .ns-detail-date {
    font-family: var(--font-geist-mono);
    font-size: 0.6875rem;
    color: var(--night-muted);
  }

  .ns-detail-title {
    font-family: var(--font-arvo);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--night-text);
    line-height: 1.3;
  }

  .ns-detail-awards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .ns-detail-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--night-border);
  }

  .ns-detail-nav {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .ns-detail-nav-link {
    text-decoration: none;
    max-width: 45%;
  }

  .ns-detail-nav-next {
    text-align: right;
    margin-left: auto;
  }

  .ns-detail-nav-label {
    display: block;
    font-family: var(--font-geist-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--night-muted);
    margin-bottom: 0.25rem;
  }

  .ns-detail-nav-title {
    display: block;
    font-family: var(--font-arvo);
    font-size: 0.875rem;
    font-weight: 400;
    transition: opacity 200ms;
  }

  .ns-detail-nav-link:hover .ns-detail-nav-title {
    opacity: 0.7;
  }

  .ns-detail-back {
    display: block;
    margin-top: 2rem;
  }
</style>

<style is:global>
  .ns-prose {
    font-family: var(--font-geist-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--night-text);
  }

  .ns-prose h2 {
    font-family: var(--font-arvo);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--night-text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .ns-prose h3 {
    font-family: var(--font-arvo);
    font-size: 1rem;
    font-weight: 400;
    color: var(--night-text);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .ns-prose p {
    margin-bottom: 1.25rem;
    color: var(--night-text);
  }

  .ns-prose a {
    color: var(--night-text);
    text-decoration: underline;
    text-decoration-color: var(--night-muted);
    text-underline-offset: 2px;
  }

  .ns-prose strong {
    color: var(--night-text);
    font-weight: 600;
  }

  .ns-prose em {
    color: var(--night-text);
  }

  .ns-prose code {
    font-family: var(--font-geist-mono);
    font-size: 0.875em;
    color: var(--night-text);
    background-color: var(--night-code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 2px;
  }

  .ns-prose pre {
    font-family: var(--font-geist-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    background-color: var(--night-code-bg);
    border: 1px solid var(--night-border);
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .ns-prose pre code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .ns-prose ul,
  .ns-prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .ns-prose li {
    margin-bottom: 0.375rem;
    color: var(--night-text);
  }

  .ns-prose blockquote {
    border-left: 2px solid var(--night-border);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--night-muted);
  }

  .ns-prose hr {
    border: none;
    border-top: 1px solid var(--night-border);
    margin: 2.5rem 0;
  }
</style>
