---
import { getCollection, render } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Typography from '@/src/components/ui/typography.astro';

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories
    .filter((story) => !story.data.draft)
    .map((story) => ({
      params: { slug: story.id },
      props: { story },
    }));
}

const { story } = Astro.props;
const { Content } = await render(story);
---

<Base title={`${story.data.title} - Sean Silvius`} description={story.data.excerpt}>
  <Container as="main" size="3xl" padding="6">
    <nav class="mb-8">
      <a href="/stories/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        &larr; Stories
      </a>
    </nav>

    <header class="mb-10">
      <Typography as="h1" variant="h1">{story.data.title}</Typography>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <time datetime={story.data.date.toISOString()}>
          {story.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {story.data.campaign && (
          <>
            <span aria-hidden="true">|</span>
            <span>{story.data.campaign}</span>
          </>
        )}
        {story.data.session && (
          <span>Session {story.data.session}</span>
        )}
      </div>
    </header>

    <Container as="article" size="2xl">
      <div class="prose prose-neutral max-w-none">
        <Content />
      </div>
    </Container>
  </Container>
</Base>
