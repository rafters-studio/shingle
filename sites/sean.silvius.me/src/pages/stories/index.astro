---
import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import H1 from '@/src/components/ui/typography-h1.astro';
import H2 from '@/src/components/ui/typography-h2.astro';
import P from '@/src/components/ui/typography-p.astro';
import Small from '@/src/components/ui/typography-small.astro';
import Card from '@/src/components/ui/card.astro';
import CardHeader from '@/src/components/ui/card-header.astro';
import CardContent from '@/src/components/ui/card-content.astro';

const stories = (await getCollection('stories'))
  .filter((story) => !story.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Stories - Sean Silvius" description="Fiction, campaigns, and narrative experiments.">
  <Container as="main" size="3xl">
    <Grid preset="linear" columns={1}>
      <H1>Stories</H1>
      <P size="xl" color="muted">Fiction, campaigns, and narrative experiments.</P>
    </Grid>

    <Grid preset="linear" columns={1} gap="6">
      {stories.map((story) => (
        <a href={`/stories/${story.id}/`}>
          <Card as="article" interactive>
            <CardHeader>
              <Small color="muted">
                <time datetime={story.data.date.toISOString()}>
                  {story.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {story.data.campaign && (
                  <> | {story.data.campaign}</>
                )}
                {story.data.session && (
                  <> Session {story.data.session}</>
                )}
              </Small>
              <H2 size="2xl">{story.data.title}</H2>
            </CardHeader>
            <CardContent>
              <P size="sm" color="muted">{story.data.excerpt}</P>
            </CardContent>
          </Card>
        </a>
      ))}
    </Grid>
  </Container>
</Base>
