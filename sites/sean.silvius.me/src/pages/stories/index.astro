---
import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Typography from '@/src/components/ui/typography.astro';
import Card from '@/src/components/ui/card.astro';

const stories = (await getCollection('stories'))
  .filter((story) => !story.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Stories - Sean Silvius" description="Fiction, campaigns, and narrative experiments.">
  <Container as="main" size="3xl" padding="6">
    <Typography as="h1" variant="h1">Stories</Typography>
    <Typography as="p" variant="lead" class="mt-2">
      Fiction, campaigns, and narrative experiments.
    </Typography>

    <div class="mt-12 flex flex-col gap-6">
      {stories.map((story) => (
        <a href={`/stories/${story.id}/`} class="no-underline">
          <Card as="article" interactive>
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
                <time datetime={story.data.date.toISOString()}>
                  {story.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {story.data.campaign && (
                  <>
                    <span aria-hidden="true">|</span>
                    <span>{story.data.campaign}</span>
                  </>
                )}
                {story.data.session && (
                  <span class="text-muted-foreground">Session {story.data.session}</span>
                )}
              </div>
              <Typography as="h2" variant="h3" class="mt-2">{story.data.title}</Typography>
              <Typography as="p" variant="muted" class="mt-2">{story.data.excerpt}</Typography>
            </div>
          </Card>
        </a>
      ))}
    </div>
  </Container>
</Base>
