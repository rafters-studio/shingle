---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import H1 from '@/src/components/ui/typography-h1.astro';
import H2 from '@/src/components/ui/typography-h2.astro';
import H3 from '@/src/components/ui/typography-h3.astro';
import P from '@/src/components/ui/typography-p.astro';
import Small from '@/src/components/ui/typography-small.astro';
import Card from '@/src/components/ui/card.astro';
import Button from '@/src/components/ui/button.astro';
import readingTime from 'reading-time';

const allPosts = await getCollection('posts', ({ data }) => {
  const isProduction = import.meta.env.PROD;
  return isProduction ? !data.draft && !data.archived : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = sortedPosts.reduce<Record<string, typeof sortedPosts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});
---

<Base title="Articles" description="Collection of things I've written down for some reason or another.">

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <H1>Articles</H1>
      <P size="xl" color="muted">Collection of things I've written down for some reason or another; mostly because I can't believe I had to say it in the first place.</P>
    </Grid>
  </Container>

  {Object.entries(grouped).map(([year, posts]) => (
    <Container size="5xl">
      <Grid preset="linear" columns={1}>
        <H2>{year}</H2>
      </Grid>
      <Grid preset="linear" columns={3} gap="6">
        {posts.map((post) => {
          const slug = post.data.slug || post.id;
          const rt = readingTime(post.body || '');
          return (
            <Card as="article" interactive>
              <a href={`/posts/${slug}/`}>
                <img
                  src={`/images/${slug}.png`}
                  alt={`Image for ${post.data.title}`}
                  loading="lazy"
                />
                <Container gap="1" background="primary">
                  <H3 size="xl" weight="bold" color="accent">{post.data.title}</H3>
                  <Small color="muted">{post.data.date.toLocaleDateString('en-US')} &bull; {rt.text}</Small>
                </Container>
                <Container gap="2">
                  <P>{post.data.excerpt}</P>
                </Container>
              </a>
              <Container>
                <a href={`/posts/${slug}/`}>
                  <Button>Read More</Button>
                </a>
              </Container>
            </Card>
          );
        })}
      </Grid>
    </Container>
  ))}

</Base>
