---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
import Card from '@/src/components/ui/card.astro';
import Button from '@/src/components/ui/button.astro';
import readingTime from 'reading-time';

const allPosts = await getCollection('posts', ({ data }) => {
  const isProduction = import.meta.env.PROD;
  return isProduction ? !data.draft && !data.archived : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const grouped = sortedPosts.reduce<Record<string, typeof sortedPosts>>((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {});
---

<Base title="Articles" description="Collection of things I've written down for some reason or another.">

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <Typography as="h1" variant="h1">Articles</Typography>
      <Typography as="p" variant="lead">Collection of things I've written down for some reason or another; mostly because I can't believe I had to say it in the first place.</Typography>
    </Grid>
  </Container>

  {Object.entries(grouped).map(([year, posts]) => (
    <Container size="5xl">
      <Grid preset="linear" columns={1}>
        <Typography as="h2" variant="h2">{year}</Typography>
      </Grid>
      <Grid preset="linear" columns={3} gap="6">
        {posts.map((post) => {
          const slug = post.data.slug || post.id;
          const rt = readingTime(post.body || '');
          return (
            <a href={`/posts/${slug}/`} class="group no-underline">
              <Card as="article" interactive class="overflow-hidden h-full">
                <div class="aspect-video overflow-hidden">
                  <img
                    src={`/images/${slug}.png`}
                    alt={`Image for ${post.data.title}`}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="bg-primary text-primary-foreground">
                  <Container gap="1">
                    <Typography as="h3" variant="h4" class="text-secondary">{post.data.title}</Typography>
                    <Typography as="span" variant="muted" class="text-primary-foreground/60">
                      {post.data.date.toLocaleDateString('en-US')} &bull; {rt.text}
                    </Typography>
                  </Container>
                </div>
                <Container gap="2">
                  <Typography as="p" variant="p">{post.data.excerpt}</Typography>
                </Container>
                <Container class="mt-auto">
                  <Button>Read More</Button>
                </Container>
              </Card>
            </a>
          );
        })}
      </Grid>
    </Container>
  ))}

</Base>
