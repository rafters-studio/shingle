---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
import Badge from '@/src/components/ui/badge.astro';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => {
    const isProduction = import.meta.env.PROD;
    return isProduction ? !data.draft && !data.archived : true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const rt = readingTime(post.body || '');
const formattedDate = post.data.date.toLocaleDateString('en-US');
const dateIso = post.data.date.toISOString();
---

<Base title={post.data.title} description={post.data.excerpt}>

  <Container size="5xl">
    <a href="/posts/" class="no-underline text-muted-foreground hover:text-foreground">
      <Typography as="span" variant="muted">&larr; All posts</Typography>
    </a>
  </Container>

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <Typography as="span" variant="small" class="uppercase tracking-widest text-muted-foreground">{post.data.title}</Typography>
      <Typography as="span" variant="muted">
        <time datetime={dateIso}>{formattedDate}</time> &bull; {rt.text}
      </Typography>
      {post.data.tags && post.data.tags.length > 0 && (
        <Grid preset="linear" columns={6} gap="2">
          {post.data.tags.map((tag: string) => (
            <Badge variant="secondary" size="sm">{tag}</Badge>
          ))}
        </Grid>
      )}
    </Grid>
  </Container>

  <Container size="5xl">
    <Typography as="h1" variant="h1">{post.data.excerpt}</Typography>
  </Container>

  <Container size="5xl">
    <img
      src={`/images/${post.id}.png`}
      alt={`Image for ${post.data.title}`}
      class="w-full object-cover shadow-md"
      loading="eager"
    />
  </Container>

  <Container size="3xl" as="article">
    <Content />
  </Container>

</Base>
