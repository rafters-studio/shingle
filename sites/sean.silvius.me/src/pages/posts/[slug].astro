---
import { getCollection, render } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Typography from '@/src/components/ui/typography.astro';
import Badge from '@/src/components/ui/badge.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts
    .filter((post) => !post.data.draft && !post.data.archived)
    .map((post) => ({
      params: { slug: post.data.slug || post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} - Sean Silvius`} description={post.data.excerpt}>
  <Container as="main" size="3xl" padding="6">
    <nav class="mb-8">
      <a href="/posts/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        &larr; All posts
      </a>
    </nav>

    <header class="mb-10">
      <Typography as="h1" variant="h1">{post.data.title}</Typography>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <time datetime={post.data.date.toISOString()} class="text-sm text-muted-foreground">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.tags.map((tag) => (
          <Badge variant="secondary">{tag}</Badge>
        ))}
      </div>
    </header>

    <Container as="article" size="2xl">
      <div class="prose prose-neutral max-w-none">
        <Content />
      </div>
    </Container>
  </Container>
</Base>
