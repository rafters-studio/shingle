---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import H1 from '@/src/components/ui/typography-h1.astro';
import H2 from '@/src/components/ui/typography-h2.astro';
import H3 from '@/src/components/ui/typography-h3.astro';
import P from '@/src/components/ui/typography-p.astro';
import Small from '@/src/components/ui/typography-small.astro';
import Card from '@/src/components/ui/card.astro';
import Button from '@/src/components/ui/button.astro';
import readingTime from 'reading-time';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.archived)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPosts = allPosts.filter((post) => post.data.featured);
const displayPosts = featuredPosts.length >= 3 ? featuredPosts.slice(0, 6) : allPosts.slice(0, 6);
---

<Base title="Sean Silvius">

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <H1 size="6xl" family="serif" weight="semibold" line="none" align="center">Hi. I build complex things in a simple manner. With bits and bytes, with wood.</H1>
      <P size="xl" color="muted" weight="medium" align="center">I log the things that have interested me, hopefully someone will find some of what I've
        learned useful in their own endeavors. I tend to make mistakes and adjust just as any
        student of life does. Those mistakes are really the important things.</P>
    </Grid>
  </Container>

  <Container size="5xl" background="muted">
    <Grid preset="linear" columns={1}>
      <H2 transform="uppercase" weight="black" align="center">Featured Articles</H2>
    </Grid>
    <Grid preset="linear" columns={3} gap="6">
      {displayPosts.map((post) => {
        const slug = post.data.slug || post.id;
        const rt = readingTime(post.body || '');
        return (
          <Card as="article" interactive>
            <a href={`/posts/${slug}/`}>
              <img
                src={`/images/${slug}.png`}
                alt={`Image for ${post.data.title}`}
                loading="lazy"
              />
              <Container gap="1" background="primary">
                <H3 size="xl" weight="bold" color="accent">{post.data.title}</H3>
                <Small color="muted">{post.data.date.toLocaleDateString('en-US')} &bull; {rt.text}</Small>
              </Container>
              <Container gap="2">
                <P>{post.data.excerpt}</P>
              </Container>
            </a>
            <Container>
              <a href={`/posts/${slug}/`}>
                <Button>Read More</Button>
              </a>
            </Container>
          </Card>
        );
      })}
    </Grid>
    <Container>
      <a href="/posts/">
        <Button variant="outline">More Articles &rsaquo;</Button>
      </a>
    </Container>
  </Container>

</Base>
