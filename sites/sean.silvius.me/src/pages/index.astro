---
export const prerender = true;

import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import Typography from '@/src/components/ui/typography.astro';
import Card from '@/src/components/ui/card.astro';
import Button from '@/src/components/ui/button.astro';
import readingTime from 'reading-time';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.archived)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPosts = allPosts.filter((post) => post.data.featured);
const displayPosts = featuredPosts.length >= 3 ? featuredPosts.slice(0, 6) : allPosts.slice(0, 6);
---

<Base title="Sean Silvius">

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <Typography as="h1" variant="h1" class="animate-fade-in duration-normal"
        >Hi. I build complex things in a simple manner. With bits and bytes, with wood.</Typography>
      <Typography as="p" variant="lead" class="animate-fade-in duration-slow delay-short"
        >I log the things that have interested me, hopefully someone will find some of what I've
        learned useful in their own endeavors. I tend to make mistakes and adjust just as any
        student of life does. Those mistakes are really the important things.</Typography>
    </Grid>
  </Container>

  <section class="bg-muted">
    <Container size="5xl">
      <Grid preset="linear" columns={1}>
        <Typography as="h2" variant="h2" class="uppercase">Featured Articles</Typography>
      </Grid>
      <Grid preset="linear" columns={3} gap="6">
        {displayPosts.map((post) => {
          const slug = post.data.slug || post.id;
          const rt = readingTime(post.body || '');
          return (
            <a href={`/posts/${slug}/`} class="group no-underline">
              <Card as="article" interactive class="overflow-hidden h-full transition-all duration-normal hover:shadow-xl hover:-translate-y-0.5">
                <div class="aspect-video overflow-hidden">
                  <img
                    src={`/images/${slug}.png`}
                    alt={`Image for ${post.data.title}`}
                    class="w-full h-full object-cover transition-transform duration-slow group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
                <div class="bg-primary text-primary-foreground">
                  <Container gap="1">
                    <Typography as="h3" variant="h4" class="text-accent">{post.data.title}</Typography>
                    <Typography as="span" variant="muted" class="text-primary-foreground/60">
                      {post.data.date.toLocaleDateString('en-US')} &bull; {rt.text}
                    </Typography>
                  </Container>
                </div>
                <Container gap="2">
                  <Typography as="p" variant="p">{post.data.excerpt}</Typography>
                </Container>
                <Container class="mt-auto text-end">
                  <Button class="uppercase font-bold tracking-tight">Read More</Button>
                </Container>
              </Card>
            </a>
          );
        })}
      </Grid>
      <Container class="text-end">
        <a href="/posts/" class="no-underline">
          <Button variant="outline" class="uppercase font-bold tracking-tight transition-all duration-normal hover:bg-secondary hover:text-secondary-foreground">More Articles &rsaquo;</Button>
        </a>
      </Container>
    </Container>
  </section>

</Base>
