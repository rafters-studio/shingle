---
import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Typography from '@/src/components/ui/typography.astro';
import Grid from '@/src/components/ui/grid.astro';
import Card from '@/src/components/ui/card.astro';

const allPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.archived)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPosts = allPosts.filter((post) => post.data.featured);
const displayPosts = featuredPosts.length >= 3 ? featuredPosts.slice(0, 6) : allPosts.slice(0, 6);
---

<Base title="Sean Silvius" heroSlot>
  <Container slot="hero" as="section" size="5xl" padding="6" class="pt-16 pb-20">
    <Typography as="h1" variant="h1" class="leading-tight max-w-4xl">
      Hi. I build complex things in a simple manner. With bits and bytes, with wood.
    </Typography>
    <Typography as="p" variant="lead" class="mt-6 text-primary-foreground/80 max-w-2xl leading-relaxed">
      I log the things that have interested me, hopefully someone will find some of what
      I've learned useful in their own endeavors. I tend to make mistakes and adjust just
      as any student of life does. Those mistakes are really the important things.
    </Typography>
  </Container>

  <Container as="main" size="5xl" padding="6">
    <Container as="section" class="py-16">
      <Typography as="h2" variant="muted" class="text-center text-xs font-semibold tracking-widest uppercase mb-10">
        Featured Articles
      </Typography>

      <Grid preset="linear" columns={3} gap="6">
        {displayPosts.map((post) => {
          const slug = post.data.slug || post.id;
          const imagePath = `/images/${slug}.png`;
          return (
            <a href={`/posts/${slug}/`} class="group no-underline">
              <Card as="article" interactive>
                <img
                  src={imagePath}
                  alt=""
                  class="w-full h-48 object-cover rounded-t-lg"
                  loading="lazy"
                />
                <div class="p-5">
                  <Typography as="h3" variant="p" class="font-bold tracking-tight text-card-foreground group-hover:text-primary transition-colors leading-snug">
                    {post.data.title}
                  </Typography>
                  <Typography as="p" variant="muted" class="mt-2 text-sm line-clamp-3 leading-relaxed">
                    {post.data.excerpt}
                  </Typography>
                  <Typography as="p" variant="small" class="mt-4 font-semibold uppercase tracking-wider text-primary">
                    Read More
                  </Typography>
                </div>
              </Card>
            </a>
          );
        })}
      </Grid>

      <div class="mt-12 text-center">
        <a
          href="/posts/"
          class="inline-block border-2 border-foreground rounded px-8 py-3 text-xs font-semibold uppercase tracking-wider text-foreground no-underline hover:bg-foreground hover:text-background transition-colors"
        >
          More Articles &rsaquo;
        </a>
      </div>
    </Container>
  </Container>
</Base>
