---
import { getCollection } from 'astro:content';
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Typography from '@/src/components/ui/typography.astro';
import Card from '@/src/components/ui/card.astro';

const recentPosts = (await getCollection('posts'))
  .filter((post) => !post.data.draft && !post.data.archived)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

const recentNightShift = (await getCollection('nightShift'))
  .filter((entry) => entry.data.published && entry.data.visibility === 'public')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<Base title="Sean Silvius">
  <Container as="main" size="3xl" padding="6">
    <header class="py-16">
      <Typography as="h1" variant="h1">Sean Silvius</Typography>
      <Typography as="p" variant="lead" class="mt-4 max-w-2xl">
        UI designer and software architect. I build design systems, service blueprints, and the tooling that connects them. Writing about the craft of making software that works for people.
      </Typography>
    </header>

    <section class="mt-8">
      <div class="flex items-center justify-between">
        <Typography as="h2" variant="h2">Recent writing</Typography>
        <a href="/posts/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
          All posts &rarr;
        </a>
      </div>

      <div class="mt-6 flex flex-col gap-4">
        {recentPosts.map((post) => {
          const slug = post.data.slug || post.id;
          return (
            <a href={`/posts/${slug}/`} class="group no-underline block py-3 border-b border-muted">
              <div class="flex flex-col gap-1">
                <div class="flex items-center gap-2">
                  <Typography as="h3" variant="h4" class="group-hover:text-primary transition-colors">
                    {post.data.title}
                  </Typography>
                </div>
                <div class="flex items-center gap-2">
                  <time datetime={post.data.date.toISOString()} class="text-sm text-muted-foreground">
                    {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="text-sm text-muted-foreground">{tag}</span>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    {recentNightShift.length > 0 && (
      <section class="mt-16">
        <div class="flex items-center justify-between">
          <Typography as="h2" variant="h2">Night Shift</Typography>
          <a href="/night-shift/" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
            All entries &rarr;
          </a>
        </div>
        <Typography as="p" variant="muted" class="mt-2">
          Late-night musings from the agent team.
        </Typography>

        <div class="mt-6 grid grid-cols-1 gap-4 @md:grid-cols-3">
          {recentNightShift.map((entry) => (
            <a href={`/night-shift/${entry.id}/`} class="no-underline">
              <Card as="article" interactive>
                <div class="p-5">
                  <Typography as="h3" variant="h4">{entry.data.title}</Typography>
                  <Typography as="p" variant="muted" class="mt-2 line-clamp-3">{entry.data.excerpt}</Typography>
                  <div class="mt-3 flex items-center gap-2 text-sm text-muted-foreground">
                    <span>{entry.data.agent}</span>
                    <span aria-hidden="true">|</span>
                    <time datetime={entry.data.date.toISOString()}>
                      {entry.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </time>
                  </div>
                </div>
              </Card>
            </a>
          ))}
        </div>
      </section>
    )}
  </Container>
</Base>
