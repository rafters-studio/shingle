---
import Base from '@/src/layouts/Base.astro';
import Container from '@/src/components/ui/container.astro';
import Grid from '@/src/components/ui/grid.astro';
import H1 from '@/src/components/ui/typography-h1.astro';
import H2 from '@/src/components/ui/typography-h2.astro';
import P from '@/src/components/ui/typography-p.astro';
import Small from '@/src/components/ui/typography-small.astro';
import Separator from '@/src/components/ui/separator.astro';

const projects = [
  {
    name: 'Legion',
    soul: 'Your agents get better every day.',
    description: 'Self-hosted AI agent orchestrator. Persistent memory, team coordination, autonomous work. Agents reflect on what they learned, consult each other when stuck, and wake up when signaled. Everything runs on your machines.',
    url: 'https://runlegion.dev',
    status: 'shipped',
    tech: 'Rust, SQLite, Tantivy, Claude Code plugin',
  },
  {
    name: 'smugglr',
    soul: 'Your data leaves when you leave.',
    description: 'Content-hashed delta sync for SQLite, wherever it runs. One CLI that moves data between D1, Turso, rqlite, local SQLite, and S3 relay. Compares SHA256 of actual row data. If nothing changed, nothing moves.',
    url: 'https://smugglr.dev',
    status: 'shipped',
    tech: 'Rust, WASM, SQLite, S3',
  },
  {
    name: 'Rafters',
    soul: 'The designer already made the decision.',
    description: 'Design system with MCP intelligence. Tokens carry the designer\'s judgment. Components are pre-styled. The MCP server answers questions about color, spacing, pattern, and cognitive load before the agent writes a line of markup.',
    url: 'https://rafters.studio',
    status: 'shipped',
    tech: 'TypeScript, OKLCH, MCP, Tailwind v4',
  },
  {
    name: 'Eavesdrop',
    soul: 'Listen to what practitioners say when they think the tools aren\'t listening.',
    description: 'Discourse crawler and corpus analysis engine. Crawls Reddit, HN, Discord for practitioner conversations. Clusters by theme. Surfaces corrections, not opinions. The evidence layer for service design decisions.',
    url: null,
    status: 'in progress',
    tech: 'Rust, SQLite, k-means, BM25',
  },
  {
    name: 'Huttspawn',
    soul: 'Opinionated guides backed by hundreds of hours played.',
    description: 'SWTOR origin story rankings, class guides, and GSF reference. Community-driven, spoiler-free, updated for current patches.',
    url: 'https://huttspawn.com',
    status: 'shipped',
    tech: 'Astro, Rafters, Cloudflare',
  },
];
---

<Base title="Software" description="What I build. Tools for sovereignty, memory, and craft.">

  <Container size="5xl">
    <Grid preset="linear" columns={1}>
      <H1>Software</H1>
      <P size="xl" color="muted">Tools I build for myself and then share. Sovereignty, memory, craft. Each one solves a problem I hit, ran for months in production, and open-sourced when it proved useful.</P>
    </Grid>
  </Container>

  <Separator />

  {projects.map((project, i) => (
    <section>
      <Container size="5xl">
        <Grid preset="linear" columns={2}>
          <Container gap="3">
            <Grid preset="linear" columns={2}>
              <H2>{project.name}</H2>
              <Small color="muted" family="mono" tracking="widest" transform="uppercase">{project.status}</Small>
            </Grid>
            <P size="2xl" weight="semibold" tracking="tight" color="secondary"><em>{project.soul}</em></P>
            <P>{project.description}</P>
            <P size="sm" color="muted" family="mono">{project.tech}</P>
          </Container>
          <Container gap="2">
            {project.url ? (
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.url.replace('https://', '')} &rarr;
              </a>
            ) : (
              <Small color="muted">Coming soon</Small>
            )}
          </Container>
        </Grid>
      </Container>
      {i < projects.length - 1 && <Separator />}
    </section>
  ))}

</Base>
