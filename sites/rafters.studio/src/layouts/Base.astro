---
import TopBar from "@/components/TopBar.astro";
import MegaFooter from "@/components/MegaFooter.astro";
import SiteHead from "@shingle/shared/SiteHead.astro";
import type { JsonLdObject } from "@shingle/shared/meta";

interface Props {
    title: string;
    description?: string;
    /** Absolute or site-relative URL for the social share image. */
    image?: string;
    /** OpenGraph content type. "article" for docs pages, "website" for everything else. */
    type?: "website" | "article";
    /** ISO 8601 timestamp for article published time. */
    publishedTime?: string;
    /** ISO 8601 timestamp for article last-modified time. */
    modifiedTime?: string;
    /** Additional JSON-LD nodes to merge into the sitewide graph. */
    extraJsonLd?: JsonLdObject[];
    /** Render a fixed topbar that fades in after the user scrolls past the hero. */
    stickyTopbar?: boolean;
}

const rawProps = Astro.props as Props & {
    frontmatter?: Partial<Props>;
};
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const {
    title,
    description = "Rafters is the Design Intelligence Protocol. Designers encode judgment; AI reads decisions.",
    image = "/logo.svg",
    type = "website",
    publishedTime,
    modifiedTime,
    extraJsonLd = [],
    stickyTopbar = false,
} = merged;

const siteOrigin = Astro.site?.origin ?? "https://rafters.studio";
const fullTitle = `${title} | Rafters`;

// The shared org + WebSite JSON-LD graph comes from SiteHead (astro-meta), so
// the head is identical across every shingle site. Only the home-page
// SoftwareApplication node is site-specific; it references the shared org by
// its @id and rides in as an extra schema node.
const isHome = Astro.url.pathname === "/";
const softwareApp: JsonLdObject = {
    "@type": "SoftwareApplication",
    "@id": `${siteOrigin}/#software`,
    name: "Rafters",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    description:
        "AI-first design system CLI. Mathematical design rules, OKLCH color science, and an MCP server that teaches AI your design decisions.",
    url: `${siteOrigin}/`,
    codeRepository: "https://github.com/rafters-studio/rafters",
    license: "https://opensource.org/licenses/MIT",
    offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
    },
    publisher: { "@id": `${siteOrigin}/#org` },
};
const extraSchema: JsonLdObject[] = [...(isHome ? [softwareApp] : []), ...extraJsonLd];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{fullTitle}</title>
        <SiteHead
            title={fullTitle}
            description={description}
            ogType={type}
            publishedTime={publishedTime}
            modifiedTime={modifiedTime}
            image={image}
            extraSchema={extraSchema}
        />
        <meta name="theme-color" content="#0a0a0a" />
        <meta name="robots" content="index, follow" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title="Rafters docs index for LLMs"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms-full.txt"
            title="Rafters docs (full) for LLMs"
        />
    </head>
    <body class="bg-background text-foreground">
        {stickyTopbar && <TopBar />}
        <main>
            <slot />
        </main>
        <MegaFooter />
    </body>
</html>

<style is:global>
    @import "../styles/global.css";
    :root {
        --font-sans:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-heading:
            "IBM Plex Sans Condensed", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-body:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-code:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
        --font-mono:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
    }
</style>
