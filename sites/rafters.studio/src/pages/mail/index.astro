---
import Base from '@/src/layouts/MailBase.astro';
import Hero from '@/components/mail/Hero.astro';
import ArchitectureSection from '@/components/mail/ArchitectureSection.astro';
import ModulesSection from '@/components/mail/ModulesSection.astro';
import WhyEdgeSection from '@/components/mail/WhyEdgeSection.astro';
import ComparisonSection from '@/components/mail/ComparisonSection.astro';
import FaqSection from '@/components/mail/FaqSection.astro';
import OssCallout from '@/components/mail/OssCallout.astro';

const bar = {
  brand: { name: '@rafters/mail', href: '#' },
  links: [
    { href: '#architecture', label: 'Architecture' },
    { href: '#modules', label: 'Modules' },
    { href: '#why', label: 'Why edge' },
    { href: '/mail/docs/', label: 'Docs' },
    { href: '#faq', label: 'FAQ' },
    { href: 'https://github.com/rafters-studio/mail', label: 'GitHub' },
  ],
};
---

<Base title="Edge-native email" description="A full-stack email framework for Cloudflare Workers. Inbound, outbound, threading, blob storage, classification, and a native IMAP server." bar={bar}>
  <main>
    <Hero />
    <ArchitectureSection />
    <ModulesSection />
    <WhyEdgeSection />
    <ComparisonSection />
    <FaqSection />
    <OssCallout />
  </main>
</Base>
