---
import SharedMegaFooter from "@shingle/shared/MegaFooter.astro";
import type { FooterColumn } from "@shingle/shared/MegaFooter.astro";

const leadingColumns: FooterColumn[] = [
  {
    heading: "Docs",
    links: [
      { label: "Overview", href: "/docs/" },
      { label: "Design Philosophy", href: "/docs/design-philosophy/" },
      { label: "Cognitive Load Scoring", href: "/docs/cognitive-load-scoring/" },
    ],
  },
  {
    heading: "Foundations",
    links: [
      { label: "Spacing", href: "/docs/spacing/" },
      { label: "Typography", href: "/docs/typography/" },
      { label: "Color", href: "/docs/color/" },
      { label: "Radius", href: "/docs/radius/" },
      { label: "Shadow", href: "/docs/shadow/" },
      { label: "Depth", href: "/docs/depth/" },
      { label: "Motion", href: "/docs/motion/" },
    ],
  },
];

const siteColumn: FooterColumn = {
  heading: "Rafters",
  links: [
    { label: "GitHub", href: "https://github.com/rafters-studio/rafters" },
    { label: "llms.txt", href: "/llms.txt" },
  ],
};
---

<SharedMegaFooter current="rafters" leadingColumns={leadingColumns} siteColumn={siteColumn} />
