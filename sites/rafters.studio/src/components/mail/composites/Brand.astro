---
interface Props {
  href?: string;
  class?: string;
}

const { href = '#', class: className } = Astro.props;
---

<a href={href} class={`inline-flex items-center gap-3 text-foreground no-underline ${className ?? ''}`}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="currentColor"
    viewBox="0 0 374 227"
    class="h-6 w-auto"
    aria-hidden="true"
  >
    <path
      d="m373.584 101.144-5.244 12.98L209.155 49.81l.07.17-203.98 82.414L0 119.413l190.715-77.055L118 12.981 123.244 0l250.34 101.144Z"
    />
  </svg>
  <span class="font-mono text-label-medium font-medium">
    <span class="text-muted-foreground">@rafters/</span>mail
  </span>
</a>
