---
import Card from '@/components/ui/card.astro';
import Container from '@/components/ui/container.astro';
import { P } from '@/components/ui/typography.astro';

interface Props {
  label: string;
  value: string;
  unit?: string;
}

const { label, value, unit } = Astro.props;
---

<Card>
<Container padding="6" gap="4">
  <span class="font-mono text-label-small uppercase tracking-wide text-muted-foreground">{label}</span>
  <div class="font-mono text-display-medium tracking-tight text-foreground leading-none">
    {value}{unit && <span class="text-body-large text-muted-foreground ml-1">{unit}</span>}
  </div>
  <P size="sm" color="muted-foreground"><slot /></P>
</Container>
</Card>
