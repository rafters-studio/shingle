---
import Card from '@/components/ui/card.astro';
import Container from '@/components/ui/container.astro';
import { H3 } from '@/components/ui/typography.astro';

interface Props {
  pathHead: string;
  pathTail: string;
  title: string;
}

const { pathHead, pathTail, title } = Astro.props;
---

<Card>
<Container padding="6" gap="4">
  <div class="font-mono text-label-small uppercase tracking-wide text-muted-foreground">
    <span class="text-foreground">{pathHead}</span>
    <span> / {pathTail}</span>
  </div>
  <H3 size="lg" tracking="tight">{title}</H3>
  <div class="text-body-small text-muted-foreground">
    <slot name="description" />
  </div>
  <div class="flex flex-wrap gap-2 mt-auto">
    <slot name="intel" />
  </div>
</Container>
</Card>
