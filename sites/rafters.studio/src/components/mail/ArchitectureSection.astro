---
import Container from '@/components/ui/container.astro';
import SectionHead from '@/components/mail/composites/SectionHead.astro';
import ArchitectureDiagram from '@/components/mail/ArchitectureDiagram.astro';
---

<section id="architecture" class="border-b border-border">
  <Container size="6xl" padding="20">
    <SectionHead no="01 / architecture" title="Edge topology.">
      Your Worker is the mail exchange. Durable Objects pin IMAP sessions.
      Adapters connect the core to whatever backends you're already running.
    </SectionHead>

    <ArchitectureDiagram />
  </Container>
</section>
