{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smugglr-shingle",
  "compatibility_date": "2026-01-30",
  "assets": {
    "directory": "dist",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "routes": [
    {
      "pattern": "smugglr.dev",
      "zone_id": "f63315125530bcc83df2de296d1d8fed",
      "custom_domain": true,
    },
  ],
}
