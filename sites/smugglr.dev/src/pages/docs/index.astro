---
import Manual from '@/src/layouts/Manual.astro';
import { manualPages } from '@/src/smugglr/manual';

type PageModule = { frontmatter: { description: string } };
const modules = import.meta.glob<PageModule>('./*.mdx', { eager: true });
const description = (route: string): string => {
  const file = `./${route.split('/').filter(Boolean).pop()}.mdx`;
  return modules[file]?.frontmatter.description ?? '';
};
---

<Manual title="smugglr manual">
  <ul>
    {
      manualPages.map((p) => (
        <li>
          <a href={p.route}>
            {p.num} {p.label}
          </a>
          : {description(p.route)}
        </li>
      ))
    }
  </ul>
</Manual>
