---
import Base from "@/src/layouts/Base.astro";
import BandHead from "@/components/band-head.astro";
import BandSection from "@/components/band-section.astro";
import InstallSection from "@/components/install-section.astro";
import WaysSection from "@/components/ways-section.astro";
import SpacedSection from "@/components/spaced-section.astro";
import SyncStage from "@/components/sync-stage.astro";
import WrapCode from "@/components/wrap-code.astro";
import Container from "@/components/ui/container.astro";
import Table from "@/components/ui/table.astro";
import {
  tableBodyClasses,
  tableCellClasses,
  tableHeadClasses,
  tableHeaderClasses,
  tableRowClasses,
} from "@/components/ui/table.classes";
import { Code, Muted, P } from "@/components/ui/typography.astro";
import MANUAL from "@/src/smugglr/manual-output.json";
import { installData, INSTALLERS } from "@/src/install/data";

const LEDE =
  "smugglr compares every row by its hash and moves only what changed. When it cannot be sure, it stops and names the rows.";
const install = await installData();
const { smugglr, migratr } = install.programs;

// Captured from the smugglr 0.6.4 release binary by scripts/capture-manual.sh; never typed.
const OUT = {
  moved_dry: MANUAL.moved_dry,
  moved_json: MANUAL.moved_json,
};

type Block =
  | { kind: "p"; text: string; code?: string }
  | { kind: "table"; head: string[]; rows: string[][] }
  | { kind: "out"; name: keyof typeof OUT }
  | { kind: "commands"; groups: { title: string; items: { label: string; command: string }[] }[] };

/** Text with `code` spans: the even parts are text, the odd parts code. */
const spans = (text: string): string[] => text.split("`");

interface Sec {
  num: string;
  title: string;
  note: string;
  blocks: Block[];
}

const SECTIONS: Sec[] = [
  {
    num: "01",
    title: "SCOPE",
    note: "what it does",
    blocks: [
      { kind: "p", text: "smugglr keeps SQLite databases in step: one Rust binary, also Rust crates and a browser package. It compares every row by a hash of its contents, so only rows that changed move. A row changed in both places stops the sync and is named; nothing is overwritten unless you say so." },
      { kind: "p", text: "`smugglr sync <a> <b> --discover` says what two places are and what a sync between them would meet, and writes nothing. `smugglr exec` runs migratr's statements on a place." },
    ],
  },
  {
    num: "02",
    title: "WAYS TO SYNC",
    note: "pick the one that fits",
    blocks: [
      {
        kind: "table",
        head: ["way", "when you need it", "how"],
        rows: [
          ["Network share", "A SQLite file on this machine kept in step with a copy on a mounted share, such as a file server at `/Volumes/office`. smugglr reads both as files by path. A direct sync: the first place named is the source, the second the target.", "`smugglr sync ./shop.db /Volumes/office/shop.db`"],
          ["Local to host", "A SQLite file on a machine kept in step with a hosted database: Cloudflare D1, or any service that speaks HTTP-SQL.", "`smugglr sync ./shop.db d1://shop`, or an https:// address for an HTTP-SQL service."],
          ["Web to host", "A web app keeps its own SQLite database in the browser tab and syncs it with a service the app runs. The service answers for the rows that belong to the signed-in user (the app's tenant id). smugglr ships no server; the smugglr repo has an example service on Cloudflare Workers with Hono and D1. A desktop app built with Tauri uses the Rust crates the same way.", "The `@smugglr/web` package: `open()` the tab's database with the endpoint the app names, then `sync()`. It is not on npm yet; it comes from the smugglr repo."],
          ["Stash and retrieve", "A person's own devices kept in step without being online together, through signed files (blobs) kept in storage the app owns. Also the way to move a large first sync.", "`smugglr stash` on one device, `smugglr retrieve` on the other."],
          ["Mesh", "Machines on one local network, with nobody in charge, kept in step as changes happen.", "`smugglr mesh ./node.db --key-file mesh.key` on each machine."],
        ],
      },
    ],
  },
  {
    num: "03",
    title: "PLACES",
    note: "what an address looks like",
    blocks: [
      {
        kind: "table",
        head: ["place", "address", "credentials"],
        rows: [
          ["A local SQLite file", "`./shop.db`", "None."],
          ["A service that speaks HTTP-SQL", "`https://...`", "smugglr sends none of its own."],
          ["Cloudflare D1", "`d1://shop`", "`CLOUDFLARE_ACCOUNT_ID` and `CLOUDFLARE_API_TOKEN`, read from the environment smugglr runs in. Set them however you keep secrets; never type them on the command line."],
          ["A browser tab", "Through the `@smugglr/web` package and the endpoint the app names.", "The headers the app's sign-in needs."],
        ],
      },
    ],
  },
  {
    num: "04",
    title: "WHEN A ROW CHANGED IN BOTH PLACES",
    note: "you choose the winner",
    blocks: [
      {
        kind: "table",
        head: ["--sync-mode", "what happens"],
        rows: [
          ["`stop`", "The default. The table stops and names the rows."],
          ["`source`", "The first place's copy is kept, and each overwritten row is named."],
          ["`target`", "The second place's copy is kept, and each overwritten row is named."],
          ["`last`", "The copy whose steering column is further on is kept. The steering column is a column you already have, such as `updated_at`."],
        ],
      },
    ],
  },
  {
    num: "05",
    title: "THE RECORD",
    note: "dry run, then the run",
    blocks: [
      { kind: "p", text: "A dry run names what would move; the run moves exactly that and says so, as text or as JSON." },
      { kind: "out", name: "moved_dry" },
      { kind: "out", name: "moved_json" },
    ],
  },
  {
    num: "06",
    title: "EXIT CODES",
    note: "what the number tells you",
    blocks: [
      {
        kind: "table",
        head: ["code", "meaning"],
        rows: [
          ["`0`", "Done, or a dry run. Every row written was read back as written."],
          ["`2`", "Refused before anything was read or written: a bad flag, place or config, or a missing D1 variable."],
          ["`3`", "Stopped before writing anything."],
          ["`4`", "Wrote something and is not done. Run it again."],
          ["`5`", "Too much for one sync. Nothing was sent."],
        ],
      },
    ],
  },
  {
    num: "07",
    title: "LIMITS",
    note: "true of smugglr 0.6.4",
    blocks: [
      { kind: "p", text: "A first sync cannot see deletes, because there is no last agreement to compare with. A table without a primary key stops the sync." },
      { kind: "p", text: "D1 refuses a query whose result is over 50 MB, and smugglr reads each D1 table in one query, so a table over 50 MB stops the sync. Put it in the config's ignore list and move it another way." },
      { kind: "p", text: "A mesh machine that restarts can be taken by the others for a second machine under its name. This is fixed for the next release." },
    ],
  },
];
---

<Base title="smugglr" description={LEDE}>
  <!-- One article around the page: llms-full.txt takes the first article, so the machine-readable summary band reaches it. -->
  <Container as="article" size="full" padding="0">
  <SyncStage />

  <WaysSection />

  <InstallSection />

  <SpacedSection label="Machine-readable summary" space="24" dark>
    <Container size="4xl" padding="0" gap="24">
      <BandHead title="MACHINE-READABLE SUMMARY" note="GET /llms.txt" />

      {
        SECTIONS.map((sec) => (
          <BandSection num={sec.num} title={sec.title} note={sec.note}>
            {sec.blocks.map((block) => {
              if (block.kind === "p") {
                return (
                  <P>
                    {spans(block.text).map((part, i) => (i % 2 ? <Code>{part}</Code> : part))}
                    {block.code && <Code>{block.code}</Code>}
                  </P>
                );
              }
              if (block.kind === "out") {
                return <WrapCode out={block.name}>{OUT[block.name]}</WrapCode>;
              }
              if (block.kind === "commands") {
                return block.groups.map((group) => (
                  <Container gap="3" padding="0">
                    <P>{group.title}</P>
                    {group.items.map((item) => (
                      <Container gap="1" padding="0">
                        <Muted>{item.label}</Muted>
                        <WrapCode>{item.command}</WrapCode>
                      </Container>
                    ))}
                  </Container>
                ));
              }
              return (
                <Table>
                  <thead class={tableHeaderClasses}>
                    <tr class={tableRowClasses}>
                      {block.head.map((cell) => (
                        <th class={tableHeadClasses}>{cell}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody class={tableBodyClasses}>
                    {block.rows.map((row) => (
                      <tr class={tableRowClasses}>
                        {row.map((cell) => (
                          <td class={tableCellClasses}>{spans(cell).map((part, j) => (j % 2 ? <Code>{part}</Code> : part))}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </Table>
              );
            })}
          </BandSection>
        ))
      }
    </Container>
  </SpacedSection>
  </Container>
</Base>
