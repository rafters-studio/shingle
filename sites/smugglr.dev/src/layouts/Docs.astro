---
import Base from './Base.astro';
import Container from '@/components/ui/container.astro';
import Grid from '@/components/ui/grid.astro';
import { Small } from '@/components/ui/typography.astro';
import type { NavGroup } from '@/src/migratr/nav';

interface Props {
  title: string;
  description?: string;
  nav?: NavGroup[];
}

const rawProps = Astro.props as Props & { frontmatter?: Partial<Props> };
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const { title = '', description, nav: navProp } = merged;
const currentPath = Astro.url.pathname.replace(/\/$/, '');

const defaultNav: NavGroup[] = [
  {
    heading: 'Start',
    items: [
      { label: 'Get Started', href: '/get-started' },
      { label: 'CLI Reference', href: '/docs/cli-reference' },
      { label: 'Configuration', href: '/docs/configuration' },
    ],
  },
  {
    heading: 'Internals',
    items: [
      { label: 'How It Works', href: '/docs/how-it-works' },
      { label: 'Usage Patterns', href: '/docs/patterns' },
      { label: 'Plugin Guide', href: '/docs/plugin-guide' },
      { label: 'Concepts', href: '/docs/concepts' },
    ],
  },
  {
    heading: 'Browser',
    items: [
      { label: 'Browser Client', href: '/docs/browser-client' },
    ],
  },
];

const nav: NavGroup[] = navProp ?? defaultNav;

function isActive(href: string, exact = false): boolean {
  if (exact) return currentPath === href;
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<Base title={title} description={description}>
  <Container size="7xl" padding="8" gap="10">
    <Grid id="docs-grid-3" columns={{ base: 1, lg: 4 }} gap="8">
      <Container colSpan={1}>
        <Container as="aside" gap="8">
          {nav.map((group) => (
            <Container gap="2">
              <Small>{group.heading}</Small>
              {group.items.map((item) => (
                <a
                  href={item.href + '/'}
                  aria-current={isActive(item.href, item.exact) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </Container>
          ))}
        </Container>
      </Container>

      <Container colSpan={3}>
        <Container as="article" gap="6">
          <slot />
        </Container>
      </Container>
    </Grid>
  </Container>
</Base>
