---
import TopBar from "@shingle/shared/TopBar.astro";
import MegaFooter from "@/components/MegaFooter.astro";
import {
    SITE_NAME,
    SITE_DESCRIPTION,
    SITE_DESCRIPTION_SHORT,
} from "@/src/site";

interface Props {
    title: string;
    description?: string;
    /** Absolute or site-relative URL for the social share image. */
    image?: string;
    /** OpenGraph content type. "article" for docs pages, "website" for everything else. */
    type?: "website" | "article";
    /** ISO 8601 timestamp for article published time. */
    publishedTime?: string;
    /** ISO 8601 timestamp for article last-modified time. */
    modifiedTime?: string;
    /** Additional JSON-LD nodes to merge into the sitewide graph. */
    extraJsonLd?: Record<string, unknown>[];
}

const rawProps = Astro.props as Props & {
    frontmatter?: Partial<Props>;
};
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const {
    title,
    description = SITE_DESCRIPTION,
    image = "/logo.webp",
    type = "website",
    publishedTime,
    modifiedTime,
    extraJsonLd = [],
} = merged;

const siteOrigin = Astro.site?.origin ?? "https://smugglr.dev";
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteImage = new URL(image, siteOrigin).href;
const fullTitle = `${title} | ${SITE_NAME}`;

const isHome = Astro.url.pathname === "/";
const jsonLdGraph: Record<string, unknown>[] = [
    {
        "@type": "WebSite",
        "@id": `${siteOrigin}/#website`,
        url: `${siteOrigin}/`,
        name: SITE_NAME,
        description: SITE_DESCRIPTION_SHORT,
        inLanguage: "en",
        publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
        "@type": "Organization",
        "@id": `${siteOrigin}/#organization`,
        name: "Rafters Studio",
        url: "https://rafters.studio",
        logo: "https://rafters.studio/logo.svg",
    },
];
if (isHome) {
    jsonLdGraph.push({
        "@type": "SoftwareApplication",
        "@id": `${siteOrigin}/#software`,
        name: SITE_NAME,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        description:
            "Universal SQLite sync engine. Content hashing, delta sync, LAN broadcast, S3 relay. Agent-friendly JSON output and structured exit codes.",
        url: `${siteOrigin}/`,
        codeRepository: "https://github.com/rafters-studio/smugglr",
        license: "https://opensource.org/licenses/MIT",
        offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
        },
        publisher: { "@id": `${siteOrigin}/#organization` },
    });
}
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [...jsonLdGraph, ...extraJsonLd],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{fullTitle}</title>
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content="#0a0a0a" />
        <meta name="robots" content="index, follow" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:locale" content="en_US" />
        {
            publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime}
                />
            )
        }
        {
            modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />

        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title={`${SITE_NAME} docs index for LLMs`}
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms-full.txt"
            title={`${SITE_NAME} docs (full) for LLMs`}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    </head>
    <body class="bg-background text-foreground">
        <TopBar
            brand={{ name: "smugglr" }}
            links={[
                { href: "/docs/", label: "docs" },
                { href: "/docs/cli/", label: "cli" },
                { href: "/migratr/", label: "migratr" },
                { href: "/compare/", label: "compare" },
                { href: "/compare/games/", label: "games" },
                { href: "https://github.com/rafters-studio/smugglr", label: "github" },
            ]}
        />
        <main>
            <slot />
        </main>
        <MegaFooter />
        <script>
            // rafters.css @imports this package inside Tailwind, which inlines it
            // without rebasing its ./files/ urls, so its faces 404 (see #190).
            // Imported here, Vite bundles the faces with their files.
            import "@fontsource-variable/noto-sans";
        </script>
    </body>
</html>

<style is:global>
    @import "../styles/global.css";

    /*
     * Tables outside rafters' Table component (bare markdown tables, the
     * compare pages' MrsTable) have no scroll container, so on a phone they
     * would widen the page (#101). display: block lets overflow-x apply to
     * them. Rafters' Table scrolls in its own wrapper, so its table (the one
     * with tableRootClasses' caption-bottom) is left alone and fills its
     * column.
     */
    table:not(.caption-bottom) {
        display: block;
        max-width: 100%;
        overflow-x: auto;
    }
</style>
