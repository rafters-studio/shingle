---
import TopBar from "@/components/TopBar.astro";
import MegaFooter from "@/components/MegaFooter.astro";
import {
    SITE_NAME,
    SITE_DESCRIPTION,
    SITE_DESCRIPTION_SHORT,
} from "@/src/site";

interface Props {
    title: string;
    description?: string;
    /** Absolute or site-relative URL for the social share image. */
    image?: string;
    /** OpenGraph content type. "article" for docs pages, "website" for everything else. */
    type?: "website" | "article";
    /** ISO 8601 timestamp for article published time. */
    publishedTime?: string;
    /** ISO 8601 timestamp for article last-modified time. */
    modifiedTime?: string;
    /** Additional JSON-LD nodes to merge into the sitewide graph. */
    extraJsonLd?: Record<string, unknown>[];
    /** Render a fixed topbar that fades in after the user scrolls past the hero. */
    stickyTopbar?: boolean;
}

const rawProps = Astro.props as Props & {
    frontmatter?: Partial<Props>;
};
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const {
    title,
    description = SITE_DESCRIPTION,
    image = "/logo.webp",
    type = "website",
    publishedTime,
    modifiedTime,
    extraJsonLd = [],
    stickyTopbar = false,
} = merged;

const siteOrigin = Astro.site?.origin ?? "https://smugglr.dev";
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const absoluteImage = new URL(image, siteOrigin).href;
const fullTitle = `${title} | ${SITE_NAME}`;

const isHome = Astro.url.pathname === "/";
const jsonLdGraph: Record<string, unknown>[] = [
    {
        "@type": "WebSite",
        "@id": `${siteOrigin}/#website`,
        url: `${siteOrigin}/`,
        name: SITE_NAME,
        description: SITE_DESCRIPTION_SHORT,
        inLanguage: "en",
        publisher: { "@id": `${siteOrigin}/#organization` },
    },
    {
        "@type": "Organization",
        "@id": `${siteOrigin}/#organization`,
        name: "Rafters Studio",
        url: "https://rafters.studio",
        logo: "https://rafters.studio/logo.svg",
    },
];
if (isHome) {
    jsonLdGraph.push({
        "@type": "SoftwareApplication",
        "@id": `${siteOrigin}/#software`,
        name: SITE_NAME,
        applicationCategory: "DeveloperApplication",
        operatingSystem: "macOS, Linux, Windows",
        description:
            "Universal SQLite sync engine. Content hashing, delta sync, LAN broadcast, S3 relay. Agent-friendly JSON output and structured exit codes.",
        url: `${siteOrigin}/`,
        codeRepository: "https://github.com/rafters-studio/smugglr",
        license: "https://opensource.org/licenses/MIT",
        offers: {
            "@type": "Offer",
            price: "0",
            priceCurrency: "USD",
        },
        publisher: { "@id": `${siteOrigin}/#organization` },
    });
}
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [...jsonLdGraph, ...extraJsonLd],
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{fullTitle}</title>
        <link rel="canonical" href={canonical} />
        <meta name="theme-color" content="#0a0a0a" />
        <meta name="robots" content="index, follow" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={absoluteImage} />
        <meta property="og:locale" content="en_US" />
        {
            publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime}
                />
            )
        }
        {
            modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={absoluteImage} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
            rel="stylesheet"
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title={`${SITE_NAME} docs index for LLMs`}
        />
        <link
            rel="alternate"
            type="text/plain"
            href="/llms-full.txt"
            title={`${SITE_NAME} docs (full) for LLMs`}
        />

        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify(jsonLd)}
        />
    </head>
    <body class="bg-background text-foreground">
        {stickyTopbar && <TopBar />}
        <main>
            <slot />
        </main>
        <MegaFooter />
    </body>
</html>

<style is:global>
    @import "../styles/global.css";

    /*
     * Tables need a scroll container and do not have one.
     *
     * Article mode styles tables with `[&_table]:w-full` and nothing else, and
     * the registry's `tableWrapperClasses` ("relative w-full overflow-auto")
     * applies only to the Table COMPONENT. Neither the .mdx docs tables nor
     * the MrsBlock tables on the home page are that component, so both are
     * bare <table> elements that never see it.
     *
     * Measured at 375px before this rule: /docs/cli-reference/ overflowed the
     * document by 136px with a 348px table inside a 311px article, and / by
     * 177px with a 472px table. That is the horizontal overflow in #101.
     *
     * This sits in Base rather than Docs because the home page has seven
     * tables and does not use the Docs layout, so a docs-scoped rule fixed
     * the smaller half of the problem and left the front page broken.
     *
     * `display: block` is what makes overflow-x apply to a table at all. It
     * costs full-width automatic column sizing, which is the accepted trade:
     * a table that scrolls beats a page that does.
     *
     * It lives here and not in container.classes.ts because that file is
     * registry-installed and the next `rafters add` would overwrite it, and it
     * targets the element rather than a class because Rafters components own
     * their classes and refuse a consumer `class` prop.
     */
    table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
    }

    :root {
        --font-sans:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-heading:
            "IBM Plex Sans Condensed", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        --font-body:
            "IBM Plex Sans", -apple-system, BlinkMacSystemFont, "Segoe UI",
            sans-serif;
        --font-code:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
        --font-mono:
            "IBM Plex Mono", "SF Mono", Monaco, "Cascadia Code", monospace;
    }
</style>
