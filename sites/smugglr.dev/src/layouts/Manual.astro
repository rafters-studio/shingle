---
import Base from './Base.astro';
import ManualShell from '@/src/components/ManualShell.astro';
import Container from '@/components/ui/container.astro';
import Sidebar from '@/components/ui/sidebar.astro';
import SidebarContent from '@/components/ui/sidebar-content.astro';
import SidebarGroup from '@/components/ui/sidebar-group.astro';
import SidebarGroupLabel from '@/components/ui/sidebar-group-label.astro';
import SidebarHeader from '@/components/ui/sidebar-header.astro';
import SidebarMenu from '@/components/ui/sidebar-menu.astro';
import SidebarMenuButton from '@/components/ui/sidebar-menu-button.astro';
import SidebarMenuItem from '@/components/ui/sidebar-menu-item.astro';
import { Lead, Muted } from '@/components/ui/typography.astro';
import { manualPages } from '@/src/smugglr/manual';
import { version } from '@/src/smugglr/version';

interface Props {
  title: string;
  description?: string;
}

const rawProps = Astro.props as Props & { frontmatter?: Partial<Props> };
const merged: Partial<Props> = { ...rawProps.frontmatter, ...rawProps };
const { title = '', description } = merged;

const current = manualPages.find((p) => p.route === Astro.url.pathname);
const pathLine = current
  ? `smugglr manual / ${current.num} ${current.label.toLowerCase()}`
  : title.toLowerCase();
---

<Base title={title} description={description} type="article">
  <ManualShell>
    <Sidebar slot="nav" id="manual-nav" contained>
      <svg
        slot="trigger"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <title>Toggle sidebar</title>
        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
        <path d="M9 3v18"></path>
      </svg>
      <SidebarHeader>
        <Muted family="mono">smugglr manual v{version}</Muted>
      </SidebarHeader>
      <SidebarContent>
        <SidebarGroup>
          <SidebarGroupLabel>Manual</SidebarGroupLabel>
          <SidebarMenu>
            {
              manualPages.map((p) => (
                <SidebarMenuItem>
                  <SidebarMenuButton asChild isActive={p === current}>
                    <a href={p.route} aria-current={p === current ? 'page' : undefined}>
                      {p.num} {p.label}
                    </a>
                  </SidebarMenuButton>
                </SidebarMenuItem>
              ))
            }
          </SidebarMenu>
        </SidebarGroup>
      </SidebarContent>
    </Sidebar>
    <Container size="3xl" gap="6" padding="6">
      <Muted family="mono">{pathLine}</Muted>
      <Container as="article">
        <h1>{title}</h1>
        {description && <Lead>{description}</Lead>}
        {
          current && (
            <>
              <Muted family="mono">## contents</Muted>
              <ul>
                {current.sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`}>
                      {s.num} {s.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
        <slot />
      </Container>
    </Container>
  </ManualShell>
</Base>
