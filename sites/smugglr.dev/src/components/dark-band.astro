---
/**
 * A full-width section under rafters' own .dark scope. Rafters has no prop for
 * a dark scope, and Container drops class, so this one element carries it,
 * with the page gutter and the band's vertical rhythm.
 *
 * @cognitive-load 0/10 - Invisible structure; its content carries the load
 * @accessibility Named by `label`, so the section is a landmark
 */
import { homeClasses as c } from "./home.classes";

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<section class={c.band} aria-label={label}>
  <slot />
</section>
