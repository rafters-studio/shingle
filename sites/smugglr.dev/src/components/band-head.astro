---
/**
 * The summary band's head: its title behind a honey marker, and a note at the
 * far end. Rafters only.
 *
 * @cognitive-load 1/10 - A label and a pointer
 */
import Container from "@/components/ui/container.astro";
import Typography, { Muted, P } from "@/components/ui/typography.astro";

interface Props {
  title: string;
  note: string;
}

const { title, note } = Astro.props;
---

<Container columns={2} gap="2">
  <P family="mono" size="xs" weight="semibold" tracking="widest" line="none">
    <Typography as="span" color="warning">»</Typography> {title}
  </P>
  <Muted family="mono" size="xs" align="end">{note}</Muted>
</Container>
