---
/**
 * One numbered section of the summary band: "## NN TITLE" with its number in
 * honey, a "# note" at the far end, then the section's body.
 *
 * @cognitive-load 2/10 - One topic per section, named before it is read
 */
import { H2, Muted } from "@/components/ui/typography.astro";
import { homeClasses as c } from "./home.classes";

interface Props {
  num: string;
  title: string;
  note: string;
}

const { num, title, note } = Astro.props;
---

<section class={c.section}>
  <header class={c.sectionHead}>
    <H2 family="mono" size="sm" weight="semibold" tracking="widest" line="none">
      <span class={c.sectionNum}>## {num}</span>{title}
    </H2>
    <Muted family="mono" size="xs"># {note}</Muted>
  </header>
  <slot />
</section>
