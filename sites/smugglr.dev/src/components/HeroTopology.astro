---
/**
 * HeroTopology - Inline animated topology diagram. Five shapes cycle on
 * a 3400ms timer; hover pauses; click a tick to jump.
 *
 * Mirrors handoff HeroTopology.jsx. Sean flagged the shape-to-verb mapping
 * as cute-not-correct; SVG payload is preserved as-is until corrected.
 *
 * Candidate for upstream rafters composite once the mapping stabilizes.
 */

const SHAPES = [
    { id: "direct", label: "Direct sync", cmd: "push · pull · sync · diff" },
    { id: "watch", label: "Watch daemon", cmd: "watch" },
    { id: "s3", label: "S3 relay", cmd: "stash · retrieve" },
    { id: "lan", label: "LAN broadcast", cmd: "broadcast" },
    { id: "snap", label: "Snapshot / restore", cmd: "snapshot · restore" },
];
---

<div
    data-topology
    class="w-full border border-border rounded bg-background px-8 py-7 flex flex-col gap-4"
>
    <div class="flex items-baseline justify-between gap-4 pb-2.5 border-b border-border">
        <div class="flex items-baseline gap-3.5 min-w-0">
            <span data-topology-idx class="font-mono text-xs text-primary">01 / 05</span>
            <span data-topology-label class="font-heading font-medium text-sm uppercase tracking-wider text-foreground">Direct sync</span>
            <span data-topology-cmd class="font-mono text-xs text-primary whitespace-nowrap overflow-hidden text-ellipsis">push · pull · sync · diff</span>
        </div>
        <span class="font-heading font-medium text-xs uppercase tracking-widest text-muted-foreground whitespace-nowrap">Shapes &middot; 5 topologies</span>
    </div>

    <div class="relative w-full h-64">
        {SHAPES.map((s, i) => (
            <svg
                data-topology-figure={s.id}
                viewBox="0 0 320 200"
                width="100%"
                height="100%"
                preserveAspectRatio="xMidYMid meet"
                class={`absolute inset-0 transition-all duration-500 ${i === 0 ? "opacity-100 scale-100" : "opacity-0 scale-[0.985] pointer-events-none"}`}
            >
                {s.id === "direct" && (
                    <g>
                        <rect x="24" y="82" width="82" height="40" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="65" y="106" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">HOST</text>
                        <g>
                            <ellipse cx="255" cy="87" rx="41" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                            <path d="M 214 87 L 214 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <path d="M 296 87 L 296 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <ellipse cx="255" cy="117" rx="41" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                        </g>
                        <text x="255" y="108" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">TARGET</text>
                        <path d="M 106 102 L 214 102" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" />
                        <path d="M 106 97 L 214 97" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <path d="M 214 107 L 106 107" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow topology-flow-reverse" fill="none" />
                        <text x="160" y="78" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--primary, currentColor)">rows</text>
                    </g>
                )}
                {s.id === "watch" && (
                    <g>
                        <rect x="24" y="82" width="82" height="40" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="65" y="106" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">HOST</text>
                        <g>
                            <ellipse cx="255" cy="87" rx="41" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                            <path d="M 214 87 L 214 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <path d="M 296 87 L 296 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <ellipse cx="255" cy="117" rx="41" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                        </g>
                        <text x="255" y="108" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">TARGET</text>
                        <path d="M 106 95 C 140 55, 180 55, 214 95" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" />
                        <path d="M 214 109 C 180 149, 140 149, 106 109" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" />
                        <path d="M 106 95 C 140 55, 180 55, 214 95" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <path d="M 214 109 C 180 149, 140 149, 106 109" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <text x="160" y="50" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--primary, currentColor)">tick · jsonl</text>
                    </g>
                )}
                {s.id === "s3" && (
                    <g>
                        <rect x="8" y="96" width="72" height="40" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="44" y="120" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">HOST A</text>
                        <path d="M 138 74 q -14 0 -14 -10 q 0 -10 14 -10 q 2 -10 16 -10 q 16 0 18 10 q 14 -2 14 10 q 0 10 -14 10 Z" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="160" y="60" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">S3</text>
                        <rect x="240" y="96" width="72" height="40" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="276" y="120" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">HOST B</text>
                        <path d="M 80 110 L 124 70" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" />
                        <path d="M 196 70 L 240 110" stroke="currentColor" stroke-width="1" opacity="0.5" fill="none" />
                        <path d="M 80 110 L 124 70" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <path d="M 196 70 L 240 110" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <text x="92" y="88" font-family="var(--font-mono)" font-size="11" fill="var(--primary, currentColor)">stash</text>
                        <text x="214" y="88" font-family="var(--font-mono)" font-size="11" fill="var(--primary, currentColor)">retrieve</text>
                    </g>
                )}
                {s.id === "lan" && (
                    <g>
                        <rect x="130" y="14" width="60" height="30" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="160" y="33" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">PEER</text>
                        <rect x="250" y="85" width="60" height="30" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="280" y="104" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">PEER</text>
                        <rect x="130" y="156" width="60" height="30" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="160" y="175" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">PEER</text>
                        <rect x="10" y="85" width="60" height="30" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="40" y="104" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">PEER</text>
                        <path d="M 190 30 L 250 100" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 5" class="topology-flow" fill="none" />
                        <path d="M 280 115 L 190 170" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 5" class="topology-flow" fill="none" />
                        <path d="M 130 170 L 40 115" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 5" class="topology-flow" fill="none" />
                        <path d="M 40 85 L 130 30" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 5" class="topology-flow" fill="none" />
                        <path d="M 160 44 L 160 156" stroke="var(--primary, currentColor)" stroke-width="1" stroke-linecap="round" stroke-dasharray="2 6" opacity="0.5" class="topology-flow" fill="none" />
                        <path d="M 250 100 L 70 100" stroke="var(--primary, currentColor)" stroke-width="1" stroke-linecap="round" stroke-dasharray="2 6" opacity="0.5" class="topology-flow" fill="none" />
                        <text x="160" y="128" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--primary, currentColor)">udp multicast &middot; masterless</text>
                    </g>
                )}
                {s.id === "snap" && (
                    <g>
                        <g>
                            <ellipse cx="44" cy="87" rx="36" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                            <path d="M 8 87 L 8 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <path d="M 80 87 L 80 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <ellipse cx="44" cy="117" rx="36" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                        </g>
                        <text x="44" y="108" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">D1</text>
                        <rect x="120" y="72" width="80" height="60" rx="2" ry="2" fill="none" stroke="currentColor" stroke-width="1" />
                        <text x="160" y="100" text-anchor="middle" font-family="var(--font-mono)" font-size="13" fill="var(--primary, currentColor)">.snap</text>
                        <text x="160" y="148" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">RELAY</text>
                        <g>
                            <ellipse cx="276" cy="87" rx="36" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                            <path d="M 240 87 L 240 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <path d="M 312 87 L 312 117" stroke="currentColor" stroke-width="1" fill="none" />
                            <ellipse cx="276" cy="117" rx="36" ry="4" fill="none" stroke="currentColor" stroke-width="1" />
                        </g>
                        <text x="276" y="108" text-anchor="middle" font-family="var(--font-heading)" font-size="11" font-weight="500" letter-spacing="0.12em" fill="currentColor" class="uppercase">TURSO</text>
                        <path d="M 80 102 L 120 102" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                        <path d="M 200 102 L 240 102" stroke="var(--primary, currentColor)" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="6 10" class="topology-flow" fill="none" />
                    </g>
                )}
            </svg>
        ))}
    </div>

    <div class="flex gap-1.5 justify-center items-center">
        {SHAPES.map((s, i) => (
            <button
                type="button"
                data-topology-tick={i}
                aria-label={s.label}
                class="appearance-none bg-transparent border-0 px-1 py-1.5 cursor-pointer"
            >
                <span
                    class={`block h-0.5 rounded-sm transition-all duration-300 ${i === 0 ? "w-7 bg-primary" : "w-2.5 bg-border"}`}
                ></span>
            </button>
        ))}
    </div>
</div>

<style>
    @keyframes topology-flow-f {
        from { stroke-dashoffset: 32; }
        to { stroke-dashoffset: 0; }
    }
    @keyframes topology-flow-r {
        from { stroke-dashoffset: 0; }
        to { stroke-dashoffset: 32; }
    }
    .topology-flow {
        animation: topology-flow-f 1.4s linear infinite;
    }
    .topology-flow-reverse {
        animation: topology-flow-r 1.4s linear infinite;
    }
</style>

<script>
    (function () {
        const root = document.querySelector<HTMLElement>("[data-topology]");
        if (!root) return;
        const figures = root.querySelectorAll<SVGElement>("[data-topology-figure]");
        const ticks = root.querySelectorAll<HTMLButtonElement>("[data-topology-tick]");
        const idxEl = root.querySelector<HTMLElement>("[data-topology-idx]");
        const labelEl = root.querySelector<HTMLElement>("[data-topology-label]");
        const cmdEl = root.querySelector<HTMLElement>("[data-topology-cmd]");

        const SHAPES = [
            { label: "Direct sync", cmd: "push · pull · sync · diff" },
            { label: "Watch daemon", cmd: "watch" },
            { label: "S3 relay", cmd: "stash · retrieve" },
            { label: "LAN broadcast", cmd: "broadcast" },
            { label: "Snapshot / restore", cmd: "snapshot · restore" },
        ];

        let active = 0;
        let paused = false;

        function render() {
            figures.forEach((f, i) => {
                const on = i === active;
                f.classList.toggle("opacity-100", on);
                f.classList.toggle("scale-100", on);
                f.classList.toggle("opacity-0", !on);
                f.classList.toggle("scale-[0.985]", !on);
                f.classList.toggle("pointer-events-none", !on);
            });
            ticks.forEach((t, i) => {
                const pill = t.querySelector("span");
                if (!pill) return;
                const on = i === active;
                pill.classList.toggle("w-7", on);
                pill.classList.toggle("bg-primary", on);
                pill.classList.toggle("w-2.5", !on);
                pill.classList.toggle("bg-border", !on);
            });
            if (idxEl) idxEl.textContent = `${String(active + 1).padStart(2, "0")} / 05`;
            if (labelEl) labelEl.textContent = SHAPES[active].label;
            if (cmdEl) cmdEl.textContent = SHAPES[active].cmd;
        }

        const timer = setInterval(() => {
            if (paused) return;
            active = (active + 1) % SHAPES.length;
            render();
        }, 3400);

        root.addEventListener("mouseenter", () => { paused = true; });
        root.addEventListener("mouseleave", () => { paused = false; });
        ticks.forEach((t, i) => {
            t.addEventListener("click", () => {
                active = i;
                render();
            });
        });

        window.addEventListener("beforeunload", () => clearInterval(timer));
    })();
</script>
