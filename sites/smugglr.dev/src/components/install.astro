---
/**
 * Install: the command as a CodeBlock, its Copy button, and where else to get
 * the binary. Rafters components and props only, at the designer's sizes.
 *
 * @cognitive-load 2/10 - One command, one action
 * @accessibility The command is real text; Copy is a native button
 */
import Button from "@/components/ui/button.astro";
import Container from "@/components/ui/container.astro";
import { CodeBlock, Muted } from "@/components/ui/typography.astro";

interface Props {
  command: string;
  note: string;
}

const { command, note } = Astro.props;
---

<Container as="section" size="4xl" padding="8" gap="4" aria-label="Install" data-install={command}>
  <CodeBlock>$ {command}</CodeBlock>
  <Container size="sm" padding="0">
    <Button id="install-copy" variant="outline">Copy</Button>
  </Container>
  <Muted align="center">{note}</Muted>
</Container>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-install]")) {
    const command = root.dataset.install;
    root.querySelector("button")?.addEventListener("click", () => {
      if (command) navigator.clipboard.writeText(command).catch(() => {});
    });
  }
</script>
