---
/**
 * Install: the one-line installer first, with its Copy button, then the
 * release's five archives by platform, each linking to its download. Rafters
 * components and props only, at the designer's sizes.
 *
 * @cognitive-load 3/10 - One command to run; five downloads grouped by platform
 * @accessibility The command is real text; Copy is a native button; every download is a named link
 */
import Button from "@/components/ui/button.astro";
import CardContent from "@/components/ui/card-content.astro";
import CardHeader from "@/components/ui/card-header.astro";
import CardTitle from "@/components/ui/card-title.astro";
import Card from "@/components/ui/card.astro";
import Container from "@/components/ui/container.astro";
import { CodeBlock, H2, H3, P } from "@/components/ui/typography.astro";

interface Props {
  /** The release, without the leading v. */
  version: string;
  command: string;
}

const { version, command } = Astro.props;
const release = `https://github.com/rafters-studio/smugglr/releases/tag/v${version}`;
const download = (file: string): string =>
  `https://github.com/rafters-studio/smugglr/releases/download/v${version}/${file}`;

const platforms = [
  {
    os: "macOS",
    builds: [
      { arch: "Apple silicon", file: "smugglr-aarch64-apple-darwin.tar.gz" },
      { arch: "Intel", file: "smugglr-x86_64-apple-darwin.tar.gz" },
    ],
  },
  {
    os: "Linux",
    builds: [
      { arch: "x86_64", file: "smugglr-x86_64-unknown-linux-gnu.tar.gz" },
      { arch: "arm64", file: "smugglr-aarch64-unknown-linux-gnu.tar.gz" },
    ],
  },
  {
    os: "Windows",
    builds: [{ arch: "x86_64", file: "smugglr-x86_64-pc-windows-msvc.zip" }],
  },
];
---

<Container as="section" size="4xl" padding="8" gap="16" aria-label="Install" data-install={command}>
  <Container gap="6">
    <H2>Install smugglr v{version}</H2>
    <P>
      On Linux and macOS, one line puts the binary in ~/.local/bin/smugglr, and says how to add that directory to PATH
      when it is not on it.
    </P>
    <Container columns={4} gap="2">
      <Container colSpan={3}>
        <CodeBlock>{command}</CodeBlock>
      </Container>
      <Container colSpan={1}>
        <Button id="install-copy" variant="primary">Copy</Button>
      </Container>
    </Container>
  </Container>

  <Container gap="6">
    <H3>Or download v{version}</H3>
    <Container columns={{ base: 1, md: 3 }} gap="4">
      {
        platforms.map((platform) => (
          <Card>
            <CardHeader>
              <CardTitle>{platform.os}</CardTitle>
            </CardHeader>
            <CardContent>
              <Container as="article" gap="2">
                {platform.builds.map((build) => (
                  <p>
                    <a href={download(build.file)} title={build.file}>
                      {build.arch}
                    </a>
                  </p>
                ))}
              </Container>
            </CardContent>
          </Card>
        ))
      }
    </Container>
    <Container as="article">
      <p>
        Each archive's SHA-256 is on <a href={release}>the v{version} release</a>.
      </p>
    </Container>
  </Container>
</Container>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-install]")) {
    const command = root.dataset.install;
    root.querySelector("button")?.addEventListener("click", () => {
      if (command) navigator.clipboard.writeText(command).catch(() => {});
    });
  }
</script>
