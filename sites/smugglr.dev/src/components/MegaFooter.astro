---
import SharedMegaFooter from "@shingle/shared/MegaFooter.astro";
import type { FooterColumn } from "@shingle/shared/MegaFooter.astro";

const leadingColumns: FooterColumn[] = [
  {
    heading: "Docs",
    links: [
      { label: "Overview", href: "/docs/" },
      { label: "Get Started", href: "/get-started/" },
      { label: "CLI Reference", href: "/docs/cli-reference/" },
      { label: "Configuration", href: "/docs/configuration/" },
    ],
  },
  {
    heading: "Internals",
    links: [
      { label: "How It Works", href: "/docs/how-it-works/" },
      { label: "Usage Patterns", href: "/docs/patterns/" },
      { label: "Plugin Guide", href: "/docs/plugin-guide/" },
      { label: "Concepts", href: "/docs/concepts/" },
    ],
  },
];

const siteColumn: FooterColumn = {
  heading: "Smuggler",
  links: [
    { label: "GitHub", href: "https://github.com/rafters-studio/smugglr" },
    { label: "llms.txt", href: "/llms.txt" },
    { label: "llms-full.txt", href: "/llms-full.txt" },
  ],
};
---

<SharedMegaFooter current="smuggler" leadingColumns={leadingColumns} siteColumn={siteColumn} />
