---
/**
 * The landing page's two companions, migratr and forgr, side by side: each
 * a name, one sentence and the way to its own page. Their docs live there.
 *
 * @cognitive-load 2/10 - Two names, two sentences, two links
 * @accessibility Headings in order; each link is named by its text
 */
import Card from "@/components/ui/card.astro";
import CardContent from "@/components/ui/card-content.astro";
import Container from "@/components/ui/container.astro";
import { H2, P } from "@/components/ui/typography.astro";
---

<Container columns={2} gap="6" padding="0">
  <Card>
    <CardContent>
      <Container gap="3" padding="0">
        <H2 color="accent-foreground">migratr</H2>
        <P>
          Schema migrations for SQLite. migratr changes a database's shape, shows every statement before it runs,
          and snapshots before every destructive step; smugglr moves the rows.
        </P>
        <P><a href="/migratr/">The migratr docs</a></P>
      </Container>
    </CardContent>
  </Card>
  <Card>
    <CardContent>
      <Container gap="3" padding="0">
        <H2 color="accent-foreground">forgr</H2>
        <P>
          Test data from the schema.json your app already has: a factory and a mock for every table, and a test
          that your SQL still fits the schema.
        </P>
        <P><a href="/forgr/">The forgr docs</a></P>
      </Container>
    </CardContent>
  </Card>
</Container>
