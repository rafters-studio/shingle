---
/**
 * Sync stage: a full-bleed animation of one sync between two SQLite files.
 *
 * @cognitive-load 4/10 - Motion carries the story; one verb and one caption at a time
 * @attention-economics Holds attention through the page's one moving element, and only while in view
 * @trust-building Every beat names what smugglr does to the row, and the conflict stops rather than guesses
 * @accessibility The animated layer is aria-hidden under a section label that tells the whole story; reduced motion gets a still version and no animation frame
 * @semantic-meaning honey = what crosses the wire, violet = the check on it
 *
 * @usage-patterns
 * DO: Place once on a page, full width
 * NEVER: Put text a reader needs only inside the animated layer
 *
 * Both themes of the still are on the server, because reduced motion runs no
 * script; the stylesheet below shows the one the viewer's theme calls for.
 * The component is standalone: everything it needs is in this file and its
 * behavior and classes files.
 */
import Container from "@/components/ui/container.astro";
import Table from "@/components/ui/table.astro";
import {
  tableBodyClasses,
  tableCaptionClasses,
  tableCellClasses,
  tableHeadClasses,
  tableHeaderClasses,
  tableRowClasses,
} from "@/components/ui/table.classes";
import Typography, { Code, H2, H3, Lead, Muted } from "@/components/ui/typography.astro";
import { SS_COPY } from "./sync-stage.behavior";
import { syncStageClasses as c } from "./sync-stage.classes";

const files = ["laptop/shop.db", "server/shop.db"];
---

<section class={c.live} data-sync-stage aria-label={SS_COPY.label}>
  <div aria-hidden="true">
    <Container size="5xl" gap="8">
      <div class={c.verb} data-ss="verb">
        <H2 weight="black" align="center" line="none">
          <span data-ss="bold">READ</span>{" "}
          <Typography as="span" weight="thin" line="none" data-ss="thin">it.</Typography>
        </H2>
      </div>
      <div class={c.closing} data-ss="closing" hidden>
        <H2 weight="thin" align="center" line="none">
          <span data-ss="closing-a"></span>{" "}
          <span data-ink>
            <Typography as="span" weight="black" line="none" color="primary-foreground" data-ss="closing-b" />
          </span>
        </H2>
      </div>
      <Lead align="center" data-ss="cap">{SS_COPY.caps[0]}</Lead>
      <div class={c.field} data-ss="field">
        <Container columns={3} gap="4" position="relative">
          {
            files.map((name, index) => (
              <Fragment>
                {index === 1 && <div />}
                <Table>
                  <caption class={tableCaptionClasses}>{name}</caption>
                  <thead class={tableHeaderClasses}>
                    <tr class={tableRowClasses}>
                      <th class:list={[tableHeadClasses, c.wide]}>key</th>
                      <th class={tableHeadClasses}>hash</th>
                      <th class:list={[tableHeadClasses, c.wide]}>match</th>
                    </tr>
                  </thead>
                  <tbody class={tableBodyClasses}>
                    {SS_COPY.keys.map((key) => (
                      <tr class={tableRowClasses}>
                        <td class:list={[tableCellClasses, c.wide]}>
                          <Code data-ss="key">{key}</Code>
                        </td>
                        <td class={tableCellClasses}>
                          <Code data-ss="hash" />
                          <span data-ss="narrow-mark" />
                        </td>
                        <td class:list={[tableCellClasses, c.wide]} data-ss="match" />
                      </tr>
                    ))}
                  </tbody>
                </Table>
              </Fragment>
            ))
          }
          <div class={c.wire} data-ss="wire"><div class={c.check} data-ss="check"></div></div>
        </Container>
      </div>
    </Container>
  </div>
</section>

{
  [false, true].map((dark) => (
    <section class={dark ? c.stillDark : c.still} aria-label={SS_COPY.stillLabel}>
      <Container size="5xl" gap="12">
        <Container as="section" columns={{ base: 1, md: 5 }} gap="6">
          {SS_COPY.still.map(([verb, line], i) => (
            <Container gap="2">
              <H3 weight="black" color={dark ? "warning" : undefined}>
                {verb}{" "}
                <Typography as="span" weight="thin" color={dark ? "warning" : undefined}>
                  it.
                </Typography>
              </H3>
              <Code>{line}</Code>
              <Muted>{SS_COPY.caps[i]}</Muted>
            </Container>
          ))}
        </Container>
        <Lead align="center">{SS_COPY.stillThen}</Lead>
        <div class={c.closing}>
          <H2 weight="thin" align="center" line="none">
            {SS_COPY.closingA}{" "}
            <span data-ink>
              <Typography as="span" weight="black" line="none" color="primary-foreground">
                {SS_COPY.closingB}
              </Typography>
            </span>
          </H2>
        </div>
      </Container>
    </section>
  ))
}

<script>
  import { bindSyncStage } from "./sync-stage.behavior";

  for (const root of document.querySelectorAll<HTMLElement>("[data-sync-stage]")) {
    bindSyncStage(root);
  }
</script>

<style is:global>
  .ss-stage {
    background: var(--background);
    color: var(--foreground);
    overflow: hidden;
    border-block: 1px solid var(--border);
    padding-block: calc(var(--spacing) * 16);
    padding-inline: max(16px, env(safe-area-inset-left, 0px));
  }
  .ss-stage table {
    display: table;
  }
  .ss-stage [data-ink] {
    background: var(--color-neutral-950);
    color: var(--color-neutral-50);
    padding: 0 0.12em;
    display: inline-block;
  }

  /* The big type: 5xl on phones, 7xl to 1024px, 8xl above; the closing line a step below. */
  .ss-verb h2,
  .ss-closing h2 {
    font-size: var(--text-5xl);
    line-height: 1;
  }
  @media (min-width: 641px) {
    .ss-verb h2 {
      font-size: var(--text-7xl);
    }
    .ss-closing h2 {
      font-size: var(--text-6xl);
    }
  }
  @media (min-width: 1025px) {
    .ss-verb h2 {
      font-size: var(--text-8xl);
    }
    .ss-closing h2 {
      font-size: var(--text-7xl);
    }
  }
  .ss-live.dark .ss-verb h2,
  .ss-live.dark .ss-verb span,
  .ss-stage.dark .ss-closing h2,
  .ss-stage.dark .ss-closing span {
    color: var(--warning);
  }

  .ss-wire {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ss-check {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    background: var(--color-silver-true-violet-300);
  }
  .ss-packet {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    height: calc(var(--spacing) * 6);
    padding-inline: calc(var(--spacing) * 2);
    background: var(--color-silver-true-honey-400);
    color: var(--color-neutral-950);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    will-change: transform;
  }
  .ss-packet.bar {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 1);
    padding: 0;
  }
  .ss-flash {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
    color: var(--color-silver-true-violet-600);
    background: var(--background);
    padding-inline: calc(var(--spacing) * 1);
    animation: ss-flash 0.7s ease-out forwards;
  }
  .ss-flash.held {
    animation: none;
  }
  .ss-stage.dark .ss-flash {
    color: var(--color-silver-true-violet-300);
  }
  .ss-stage.dark .ss-check {
    background: var(--color-silver-true-violet-600);
  }
  @keyframes ss-flash {
    0%,
    55% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* A third of a phone holds one column: the hash and its mark. */
  [data-ss="narrow-mark"] {
    display: none;
  }
  @media (max-width: 640px) {
    .ss-wide {
      display: none;
    }
    [data-ss="narrow-mark"] {
      display: inline;
    }
    .ss-field > [data-part="root"] {
      gap: calc(var(--spacing) * 2);
    }
    .ss-field th,
    .ss-field td {
      padding-inline: calc(var(--spacing) * 1);
      white-space: nowrap;
    }
  }

  /* Live or still, and which still: reduced motion runs no script, so CSS picks. */
  .ss-still {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-live {
      display: none;
    }
    .ss-still:not(.dark) {
      display: block;
    }
    :root[data-theme="dark"] .ss-still:not(.dark) {
      display: none;
    }
    :root[data-theme="dark"] .ss-still.dark {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) and (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .ss-still:not(.dark) {
      display: none;
    }
    :root:not([data-theme="light"]) .ss-still.dark {
      display: block;
    }
  }
</style>
