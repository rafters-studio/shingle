---
interface Props {
  command: string;
  subline?: string;
  class?: string;
}

const { command, subline, class: className } = Astro.props;
---

<div class:list={["flex flex-col gap-3", className]}>
  <div class="relative rounded-md bg-background border border-border font-mono text-sm">
    <pre class="px-4 py-3 pr-12 overflow-x-auto"><span class="select-none text-muted-foreground" aria-hidden="true">$ </span><code>{command}</code></pre>
    <button
      type="button"
      data-copy={command}
      aria-label="Copy install command"
      class="absolute top-2 right-2 p-1.5 rounded text-muted-foreground hover:text-foreground hover:bg-muted opacity-60 hover:opacity-100 focus-visible:opacity-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-opacity"
    >
      <svg class="icon-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1 .9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="icon-check" hidden width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="20 6 9 17 4 12" />
      </svg>
    </button>
    <span data-copy-live class="sr-only" aria-live="polite"></span>
  </div>

  {subline && <p class="text-xs text-muted-foreground font-mono">{subline}</p>}
</div>

<script>
  function wireCopyButtons() {
    const buttons = document.querySelectorAll<HTMLButtonElement>("button[data-copy]");
    buttons.forEach((btn) => {
      if (btn.dataset.copyWired === "true") return;
      btn.dataset.copyWired = "true";
      btn.addEventListener("click", async () => {
        const text = btn.dataset.copy;
        if (!text) return;
        const copyIcon = btn.querySelector<SVGElement>(".icon-copy");
        const checkIcon = btn.querySelector<SVGElement>(".icon-check");
        const live = btn.parentElement?.querySelector<HTMLElement>("[data-copy-live]");
        try {
          await navigator.clipboard.writeText(text);
          if (copyIcon) copyIcon.hidden = true;
          if (checkIcon) checkIcon.hidden = false;
          if (live) live.textContent = "Copied";
          window.setTimeout(() => {
            if (copyIcon) copyIcon.hidden = false;
            if (checkIcon) checkIcon.hidden = true;
            if (live) live.textContent = "";
          }, 2000);
        } catch {}
      });
    });
  }

  wireCopyButtons();
  document.addEventListener("astro:page-load", wireCopyButtons);
</script>
