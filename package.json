{
  "name": "shingle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present --workspace-concurrency=1 typecheck",
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "preflight": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@rafters/toolchain": "catalog:",
    "wrangler": "catalog:"
  }
}
